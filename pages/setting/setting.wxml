<!-- 设置页：五个功能按钮（占位） -->
<view class="page {{themeClass}}">
  <view class="menu-section">
    <view class="menu-title">设置</view>
    <view class="menu-card">
      <!-- id=guide-theme：新手引导第 5 步的定位锚点（id 唯一，勿改） -->
      <view class="menu-item" id="guide-theme" bindtap="onToggleTheme">
        <text class="menu-icon ri ri-palette-line"></text><text class="menu-text">主题</text>
        <text class="menu-value">{{themeLabel}}</text>
        <text class="menu-arrow ri {{themePanelOpen ? 'ri-arrow-up-s-line' : 'ri-arrow-down-s-line'}}"></text>
      </view>
      <view class="menu-item" bindtap="goToFontSetting">
        <text class="menu-icon ri ri-font-size-line"></text><text class="menu-text">日记字体</text>
        <text class="menu-arrow ri ri-arrow-right-s-line"></text>
      </view>
      <view class="menu-item" bindtap="goToReminder">
        <text class="menu-icon ri ri-alarm-line"></text><text class="menu-text">闹钟</text>
        <text class="menu-arrow ri ri-arrow-right-s-line"></text>
      </view>
      <view class="menu-item" bindtap="goToLock">
        <text class="menu-icon ri ri-lock-line"></text><text class="menu-text">日记本密码</text>
        <text class="menu-value">{{lockLabel}}</text>
        <text class="menu-arrow ri ri-arrow-right-s-line"></text>
      </view>
      <view class="menu-item menu-item-ai" bindtap="onComingSoon" data-name="AI模型">
        <text class="menu-icon ri ri-quill-pen-line"></text><text class="menu-text">AI模型</text>
        <text class="menu-arrow ri ri-arrow-right-s-line"></text>
      </view>
      <view class="menu-item" bindtap="clearAllDiaries">
        <text class="menu-icon danger ri ri-delete-bin-line"></text><text class="menu-text">清除所有日记</text>
        <text class="menu-arrow ri ri-arrow-right-s-line"></text>
      </view>
      <view class="menu-item" bindtap="goToAbout">
        <text class="menu-icon ri ri-information-line"></text><text class="menu-text">关于</text>
        <text class="menu-arrow ri ri-arrow-right-s-line"></text>
      </view>
      <!-- 新手引导（重看入口）：清掉「已看过」标记 → 回写日记页，由那一页自动开播 -->
      <view class="menu-item" bindtap="restartGuide">
        <text class="menu-icon ri ri-book-open-line"></text><text class="menu-text">新手引导</text>
        <text class="menu-value">再看看主要功能</text>
        <text class="menu-arrow ri ri-arrow-right-s-line"></text>
      </view>
    </view>
    <view class="menu-card theme-card" wx:if="{{themePanelOpen}}">
      <view class="theme-opts">
        <view class="theme-opt {{themeMode === 'light' ? 'on' : ''}}" bindtap="onPickTheme" data-mode="light">
          <view class="theme-mock">
            <view class="mock-title"></view>
            <view class="mock-card"><view class="mock-line"></view><view class="mock-accent"></view></view>
          </view>
          <text class="theme-opt-label">浅色</text>
        </view>
        <view class="theme-opt {{themeMode === 'dark' ? 'on' : ''}}" bindtap="onPickTheme" data-mode="dark">
          <view class="theme-mock mock-dark">
            <view class="mock-title"></view>
            <view class="mock-card"><view class="mock-line"></view><view class="mock-accent"></view></view>
          </view>
          <text class="theme-opt-label">深色</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 新手引导遮罩：第 5 步（主题）在本页续接（从写日记页「去设置」跨页过来）；
       位置计算在 utils/guide.js，交互回到本页处理 -->
  <guide-mask
    visible="{{guideVisible}}"
    step="{{guideStep}}"
    rect="{{guideRect}}"
    shape="{{guideShape}}"
    bind:next="onGuideNext"
    bind:skip="onGuideSkip"
  />
</view>

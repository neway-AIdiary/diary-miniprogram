/* ===== 设置页：极简琥珀编辑风 cell 列表 ===== */
.page {
  min-height: 100vh;
  background: var(--bg);
  padding: 32rpx 0 60rpx;
  box-sizing: border-box;
}

.menu-section {
  padding: 0 24rpx;
}

.menu-title {
  font-family: var(--font-display);
  font-size: var(--title-3);
  color: var(--title-ink-3);
  letter-spacing: var(--title-track-3);
  font-weight: var(--title-w-3);
  padding: 0 8rpx 16rpx;
}

.menu-card {
  background: var(--surface);
  border: 1rpx solid var(--line-soft);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-sm);
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 36rpx 32rpx;
  border-bottom: 1rpx solid var(--line-soft);
  transition: background var(--dur) var(--ease);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background: var(--surface-press);
}

.menu-icon {
  font-size: 40rpx;
  line-height: 1;
  color: var(--ink);
  margin-right: 16rpx;
  flex-shrink: 0;
}

.menu-item-ai .menu-icon {
  color: var(--ai);
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: var(--ink);
}

.menu-arrow {
  font-size: 36rpx;
  color: var(--ink-faint);
  line-height: 1;
}

/* ===== 主题切换面板 ===== */
.menu-value {
  font-size: 26rpx;
  color: var(--ink-soft);
  margin-right: 8rpx;
}

.theme-card {
  margin-top: var(--sp-md);
  padding: 24rpx;
}

.theme-opts {
  display: flex;
  gap: 24rpx;
}

.theme-opt {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 16rpx 16rpx;
  border-radius: var(--r-md);
  border: 2rpx solid var(--line-soft);
  transition: border-color var(--dur) var(--ease), background var(--dur) var(--ease);
}

.theme-opt.on {
  border-color: var(--brand);
  background: var(--brand-tint-08);
}

/* 双主题示意小样：颜色写死，无论当前处于哪个主题都如实预览两套外观 */
.theme-mock {
  width: 100%;
  border-radius: var(--r-sm);
  background: #EFEBE5;
  padding: 16rpx 14rpx;
  box-sizing: border-box;
}

.mock-title {
  width: 40%;
  height: 8rpx;
  border-radius: 4rpx;
  background: rgba(51, 51, 51, 0.55);
  margin-bottom: 12rpx;
}

.mock-card {
  background: #FFFFFF;
  border-radius: 6rpx;
  padding: 12rpx;
}

.mock-line {
  height: 6rpx;
  border-radius: 3rpx;
  background: rgba(51, 51, 51, 0.28);
  margin-bottom: 8rpx;
}

.mock-accent {
  width: 34%;
  height: 10rpx;
  border-radius: 5rpx;
  background: #5A5247;
}

.theme-mock.mock-dark {
  background: #1B1916;
}

.mock-dark .mock-title {
  background: rgba(232, 226, 216, 0.60);
}

.mock-dark .mock-card {
  background: #262320;
}

.mock-dark .mock-line {
  background: rgba(232, 226, 216, 0.30);
}

.mock-dark .mock-accent {
  background: #9C8E7B;
}

.theme-opt-label {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: var(--ink-mid);
}

.theme-opt.on .theme-opt-label {
  color: var(--ink);
  font-weight: 600;
}

/* 清除所有日记：垃圾桶图标警示红（文字与普通菜单一致） */
.menu-icon.danger {
  color: var(--danger);
}



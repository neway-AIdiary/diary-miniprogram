/* ===== 设置页：极简琥珀编辑风 cell 列表 ===== */
.page {
  min-height: 100vh;
  background: var(--bg);
  padding: 32rpx 0 60rpx;
  box-sizing: border-box;
}

.menu-section {
  padding: 0 24rpx;
}

.menu-title {
  font-family: var(--font-display);
  font-size: 26rpx;
  color: var(--ink-soft);
  letter-spacing: 2rpx;
  padding: 0 8rpx 16rpx;
}

.menu-card {
  background: var(--surface);
  border: 1rpx solid var(--line-soft);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-sm);
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 36rpx 32rpx;
  border-bottom: 1rpx solid var(--line-soft);
  transition: background var(--dur) var(--ease);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background: var(--surface-press);
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: var(--ink);
}

.menu-arrow {
  font-size: 36rpx;
  color: var(--ink-faint);
  line-height: 1;
}

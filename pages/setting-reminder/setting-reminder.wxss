/* ===== 闹钟设置页：极简琥珀编辑风 ===== */
.page {
  min-height: 100vh;
  background: var(--bg);
  padding: 32rpx 24rpx 60rpx;
  box-sizing: border-box;
}

/* 顶部主卡 */
.card {
  background: var(--surface);
  border: 1rpx solid var(--line-soft);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-sm);
  padding: 8rpx 0;
  margin-bottom: 32rpx;
}

.card-title {
  font-family: var(--font-display);
  font-size: 26rpx;
  color: var(--ink-soft);
  letter-spacing: 2rpx;
  padding: 28rpx 32rpx 12rpx;
}

/* 周期 tab */
.cycle-tabs {
  display: flex;
  gap: 16rpx;
  padding: 8rpx 32rpx 24rpx;
}

.cycle-tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: var(--r-md);
  border: 1rpx solid var(--line-soft);
  font-size: 28rpx;
  color: var(--ink-soft);
  background: var(--bg);
  transition: all var(--dur) var(--ease);
}

.cycle-tab.active {
  background: var(--brand);
  color: #fff;
  border-color: var(--brand);
  box-shadow: var(--shadow-sm);
}

/* 时间行 */
.field-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-top: 1rpx solid var(--line-soft);
}

.field-label {
  font-size: 30rpx;
  color: var(--ink);
}

.field-value-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.field-value {
  font-family: var(--font-display);
  font-size: 32rpx;
  color: var(--brand);
  letter-spacing: 1rpx;
}

.field-arrow {
  font-size: 32rpx;
  color: var(--ink-faint);
  line-height: 1;
}

/* 周几选择 */
.weekday-row {
  padding: 24rpx 32rpx 32rpx;
  border-top: 1rpx solid var(--line-soft);
}

.weekday-label {
  font-size: 26rpx;
  color: var(--ink-soft);
  margin-bottom: 16rpx;
}

.weekday-list {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.weekday-item {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: 1rpx solid var(--line-soft);
  background: var(--bg);
  font-size: 26rpx;
  color: var(--ink-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all var(--dur) var(--ease);
}

.weekday-item.active {
  background: var(--brand);
  color: #fff;
  border-color: var(--brand);
}

/* 底部状态卡 */
.bottom-card {
  background: var(--surface);
  border: 1rpx solid var(--line-soft);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-sm);
  padding: 32rpx;
}

.bottom-status {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.status-text {
  font-family: var(--font-display);
  font-size: 30rpx;
  color: var(--ink);
  letter-spacing: 1rpx;
  flex: 1;
}

.hint-text {
  font-size: 24rpx;
  color: var(--ink-faint);
  line-height: 1.6;
}
/* ===== 详情页：微信小程序标准阅读风格 · 浅青绿底 =====
   整页锁死（100vh + overflow:hidden）：
   - 查看模式：详情卡片在页面内浮动，正文 scroll-view 独立滚动，
              卡片顶部（标题/日期）始终固定在视口顶端，不会被压盖
   - 编辑模式：.edit-page 是 fixed 单独铺满，与 .page 无关 */
.page {
  height: 100vh;
  overflow: hidden;
  background: var(--bg);
  padding: 24rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

/* 查看模式：白色阅读卡片 */
.detail-card {
  background: var(--surface);
  border-radius: 16rpx;
  padding: 48rpx 36rpx 40rpx;
  flex: 1 1 auto;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.detail-title {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.5;
  margin-bottom: 24rpx;
  flex-shrink: 0;
}

.detail-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid var(--line);
  flex-shrink: 0;
}

.detail-date {
  font-size: 24rpx;
  color: var(--ink-soft);
}

.detail-tags {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  justify-content: flex-end;
}

.tag-ai {
  font-size: 20rpx;
  color: var(--ai-deep);
  background: var(--ai-soft);
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.tag-mood {
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

/* 自动标签（d.tags，由 callAITags 生成）→ AI 产物，统一 AI 语义蓝；
   字体色用 --ai-deep 保证小字对比度，底/描边用 --ai-soft / --ai-tint-25 */
.tag-chip {
  font-size: 20rpx;
  color: var(--ai-deep);
  background: var(--ai-soft);
  border: 1rpx solid var(--ai-tint-25);
  padding: 4rpx 16rpx;
  border-radius: 40rpx;
}

.detail-content {
  font-size: 30rpx;
  color: var(--ink);
  line-height: 2;
  white-space: pre-wrap;
  word-wrap: break-word;
}

/* 逐行渲染：空行保留一行高度；小标题行（◆/◇）只加粗、不上色 */
.content-line {
  min-height: 58rpx;
  text-indent: 1em;   /* 段首缩进一格（中文排版习惯） */
}
.content-line-heading {
  font-weight: bold;
  text-indent: 0;     /* 小标题不缩进 */
}

/* 详情卡片内部滚动区：flex 自适应剩余空间，内容超长在卡片内滚动 */
.detail-scroll {
  display: block;
  flex: 1 1 auto;
  min-height: 0;
}

.detail-scroll-inner {
  display: block;
  padding-bottom: 24rpx;
}

/* 详情位置 & 天气（同一行，中间弹性间隔） */
.detail-meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--line-soft);
}

.detail-location {
  font-size: 26rpx;
  color: var(--ink-soft);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex-shrink: 1;
  min-width: 0;
}

.detail-weather {
  font-size: 26rpx;
  color: var(--ink-soft);
  flex-shrink: 0;
}

/* 详情媒体：网格布局 */
.detail-media {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
}

.detail-media-img,
.detail-media-video {
  width: calc((100% - 32rpx) / 3);
  height: 210rpx;
  border-radius: 12rpx;
  background: var(--bg);
}

.detail-media-img {
  display: block;
}

/* 视频：原生组件会按封面/控件比例多撑出几 rpx，用 overflow 裁掉，防止超出卡片 */
.detail-media-video {
  display: block;
  overflow: hidden;
  box-sizing: border-box;
  vertical-align: top;
}

/* 操作按钮 */
.detail-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
  padding-bottom: 24rpx;
  flex-shrink: 0;
}

.detail-actions button {
  flex: 1;
}

/* 危险按钮：微信标准红 · 渐变实心 */
.btn-danger {
  background: linear-gradient(135deg, var(--danger) 0%, var(--danger) 100%);
  color: var(--surface);
  border: none;
  border-radius: 48rpx;
  padding: 21rpx 48rpx;
  font-size: 32rpx;
  font-weight: 500;
  text-align: center;
  line-height: 1.5;
  box-shadow: 0 10rpx 24rpx var(--danger-tint-25);
}

.btn-danger:active {
  box-shadow: none;
}

/* 编辑模式 */
.edit-area {
  margin: 0 24rpx;
  padding: 0 28rpx 16rpx;
  flex: 0 1 auto;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.section {
  margin-bottom: 16rpx;
}

/* 标题区 / 心情区：固定在上，底部加详情页同款分隔线，三块（标题/心情/正文）区隔 */
.section-title,
.section-mood {
  flex-shrink: 0;
  border-bottom: 1rpx solid var(--line);
  padding-bottom: 20rpx;
}

/* 心情选择：上下留白减半 */
.mood-bar {
  background: var(--surface);
  border-radius: 16rpx;
  padding: 14rpx 28rpx;
  display: flex;
  align-items: center;
}

.mood-label {
  font-size: 28rpx;
  color: var(--ink);
  font-weight: 500;
  flex-shrink: 0;
}

.mood-value {
  flex: 1;
  font-size: 28rpx;
  margin-left: 24rpx;
  color: var(--ink);
}

.mood-value.placeholder {
  color: var(--ink-soft);
}

/* 心情行右侧可点击箭头 */
.mood-arrow {
  flex-shrink: 0;
  margin-left: 8rpx;
  font-size: 36rpx;
  line-height: 1;
  color: var(--ink-faint);
}

.mood-bar-hover {
  opacity: 0.7;
}

.mood-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 8rpx;
  padding: 12rpx;
  background: var(--surface);
  border-radius: 16rpx;
}

.mood-option {
  padding: 10rpx 22rpx;
  background: var(--bg-soft);
  border-radius: 40rpx;
  font-size: 26rpx;
  color: var(--ink-mid);
}

.mood-option.active {
  background: linear-gradient(135deg, var(--brand-bright) 0%, var(--brand-deep) 100%);
  color: var(--surface);
  font-weight: 500;
  box-shadow: 0 6rpx 16rpx var(--brand-tint-25);
}

.edit-actions {
  display: flex;
  align-items: center;
  gap: 20rpx;
  /* 按钮沉到内容区最底部（margin-top:auto），下边正好落在 .edit-page 底留白划出的那条线上；
     padding-bottom 归零，按钮最下边的位置 = 距屏幕底部 190rpx，与写日记页【AI优化】【保存日记】对齐 */
  margin: auto 24rpx 0;
  padding-bottom: 0;
}

.edit-actions button {
  flex: 1;
}

/* 编辑态正文：与主页输入框一致，透明无边框、衬线体、随内容自动增高、超出 60vh 后自滚动 */
.edit-area .textarea-field {
  background: transparent;
  border: none;
  padding: 0;
  font-family: var(--font-display);
  min-height: 330rpx;
  max-height: 60vh;
  line-height: 1.95;
  letter-spacing: 0.3rpx;
}

/* 字数统计 */
.char-count {
  text-align: right;
  font-size: 24rpx;
  color: var(--ink-faint);
  margin-top: 10rpx;
  padding-right: 8rpx;
}

/* 编辑模式标题输入框：固定高度 81rpx（约原 108 的四分之三），上下居中完整显示
   编辑风增强层会把字号改为 42rpx / 行高 ~57rpx，
   上下内边距各 11rpx → 内容区 59rpx，恰好完整容纳一行文字；
   去边框去底色，与主页输入框风格统一 */
.edit-title-input {
  height: 81rpx;
  box-sizing: border-box;
  padding: 11rpx 0;
  border: none;
  background: transparent;
  font-weight: 500;
}

/* ===== 编辑模式：位置卡片（微信位置消息样式）===== */
.loc-card {
  display: flex;
  align-items: center;
  background: var(--surface);
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

/* 地图选点同款大头针（红色圆头+白孔+尖角）；腿长 15→30rpx 延长一倍，容器加高并整体下移居中 */
.loc-icon {
  position: relative;
  width: 40rpx;
  height: 40rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 红色圆头（略带球面高光与投影） */
.loc-icon .pin-ball {
  position: absolute;
  top: 4rpx;
  left: 5rpx;
  width: 26rpx;
  height: 26rpx;
  border-radius: 50%;
  background: linear-gradient(180deg, var(--danger-bright) 0%, var(--danger) 55%, var(--danger-deep) 100%);
  box-shadow: inset 0 2rpx 2rpx rgba(255, 255, 255, 0.35), inset 0 -3rpx 4rpx var(--danger-shadow), 0 2rpx 4rpx rgba(0, 0, 0, 0.15);
}

/* 圆头正中白孔 */
.loc-icon .pin-hole {
  position: absolute;
  top: 12rpx;
  left: 50%;
  width: 8rpx;
  height: 8rpx;
  transform: translateX(-50%);
  background: var(--surface);
  border-radius: 50%;
  box-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.2);
}

/* 底部尖角（与圆头同色，圆头下沿被尖覆盖形成一体） */
.loc-icon .pin-tip {
  position: absolute;
  top: 23rpx;
  left: 50%;
  width: 0;
  height: 0;
  transform: translateX(-50%);
  border-left: 6rpx solid transparent;
  border-right: 6rpx solid transparent;
  border-top: 30rpx solid var(--danger-deep);
}

.loc-info {
  flex: 1;
  min-width: 0;
}

.loc-name {
  display: block;
  font-size: 28rpx;
  color: var(--ink);
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.loc-addr {
  display: block;
  font-size: 22rpx;
  color: var(--ink-soft);
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.loc-clear {
  font-size: 28rpx;
  color: var(--ink-faint);
  padding: 8rpx 0 8rpx 24rpx;
  flex-shrink: 0;
}

/* ===== 编辑模式：媒体网格（长按拖动排序，与微信朋友圈一致）===== */
.edit-media-grid {
  position: relative;
  margin-top: 20rpx;
}

.edit-media-item {
  position: absolute;
  left: 0;
  top: 0;
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  overflow: visible;
  transition: transform 0.2s ease;
  will-change: transform;
}

/* 拖动中：跟手（transition 关闭避免拖影）+ 浮起放大 + 阴影 */
.edit-media-item.dragging {
  transition: none;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.25);
  border-radius: 16rpx;
}

.edit-media-img {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
  background: var(--line-soft);
  display: block;
}

/* 视频缩略图：与详情页一致，用 video 组件显示真实首帧封面 */
.edit-media-video {
  position: relative;
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
  overflow: hidden;
  background: var(--line-soft);
  box-sizing: border-box;
}

.edit-media-video-inner {
  width: 100%;
  height: 100%;
  display: block;
}

.edit-media-dur {
  position: absolute;
  right: 8rpx;
  bottom: 8rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  background: rgba(0, 0, 0, 0.5);
  color: var(--surface);
  font-size: 20rpx;
}

.edit-media-remove {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  color: var(--surface);
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 拖动提示文案 */
.edit-media-tip {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: var(--ink-faint);
  text-align: center;
}

/* ===== 编辑模式页面结构：滚动区 + 底部输入栏 =====
   用 fixed 铺满视口 + overflow hidden：与写日记主页一致，
   页面本身不滚动，底栏始终固定在底部 */
.edit-page {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  background: var(--bg);
  overflow: hidden;
  z-index: 10;
  /* 底留白 = 取消/保存按钮最下边的位置（距屏幕底部 190rpx），
     与写日记页【AI优化】【保存日记】完全一致；配合 .edit-actions 的 margin-top:auto 生效。
     底部输入栏是 fixed 定位（.edit-bottom），不受本留白影响 */
  padding-bottom: 190rpx;
  box-sizing: border-box;
}

.edit-scroll {
  display: block;
}

/* 滚动内容容器 */
.edit-scroll-inner {
  display: block;
}

/* ===== 底部固定区：面板 + 输入栏 =====
   面板展开时压盖在编辑区、取消/保存按钮之上 */
.edit-bottom {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
  background: transparent;
}

/* ===== 底部输入栏（复用写日记主页底栏所有元素）===== */
.input-bar {
  flex-shrink: 0;
  display: flex;
  align-items: flex-end;
  margin-top: 0;
  background: rgba(248, 244, 238, 0.95);
  border-top: 1rpx solid var(--line-soft);
  padding: 12rpx 16rpx 22rpx;
  z-index: 20;
}

.input-btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  flex-shrink: 0;
}

.input-btn.active {
  background: var(--line-soft);
  border-radius: 16rpx;
}

.input-middle {
  flex: 1;
  min-width: 0;
  margin: 0 12rpx;
}

/* 按住说话（豆包同款圆角/底色） */
.hold-talk {
  height: 80rpx;
  background: var(--bg-soft);
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--ink);
}

.hold-talk:active,
.hold-talk.recording {
  background: var(--line-strong);
  color: var(--brand);
}

.hold-talk.canceling {
  background: var(--danger-soft);
  color: var(--danger-bright);
}

/* 快捷输入框（豆包同款圆角/底色） */
.input-text {
  width: 100%;
  box-sizing: border-box;
  background: var(--bg-soft);
  border-radius: 40rpx;
  padding: 16rpx 24rpx;
  font-size: 28rpx;
  color: var(--ink);
  line-height: 48rpx;
  min-height: 80rpx;
  max-height: 160rpx;
}

.input-add {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: 300;
  color: var(--ink);
  flex-shrink: 0;
}

.input-add.active {
  background: var(--line-soft);
  border-radius: 16rpx;
}

/* 发送态 */
.input-add.send {
  width: 120rpx;
  background: var(--brand);
  color: var(--surface);
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.input-add.send:active {
  background: var(--brand);
}

/* ===== 底栏图标：豆包同款（麦克风/键盘/加号）+ 飞书同款笑脸 ===== */
.icon-bar {
  width: 52rpx;
  height: 52rpx;
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
}

.icon-mic {
  background-image: url("data:image/svg+xml;base64,");
}

.icon-keyboard {
  background-image: url("data:image/svg+xml;base64,");
}

.icon-plus {
  background-image: url("data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCI+PHBhdGggZmlsbD0iIzVBNTI0NyIgZD0iTTExIDExVjVIMTNWMTFIMTlWMTNIMTNWMTlIMTFWMTNINVYxMUgxMVoiLz48L3N2Zz4=");
}

.icon-smiley {
  background-image: url("data:image/svg+xml;base64,");
}

/* ===== 面板（表情 / 添加）===== */
.panel {
  flex-shrink: 0;
  background: var(--surface);
  border-top: 1rpx solid var(--line);
  z-index: 25;
}

.panel-tabs {
  display: flex;
  border-bottom: 1rpx solid var(--line-soft);
}

.panel-tab {
  padding: 20rpx 40rpx;
  font-size: 28rpx;
  color: var(--ink-mid);
  position: relative;
}

.panel-tab.active {
  color: var(--brand);
  font-weight: 500;
}

.panel-tab.active::after {
  content: '';
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  bottom: 0;
  width: 48rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: var(--brand);
}

/* 表情网格 */
.emoji-scroll {
  height: 420rpx;
}

.emoji-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 16rpx 8rpx;
}

.emoji-item {
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  white-space: nowrap;
}

/* 颜文字：长字符串，自适应宽度 + 小字号，避免溢出重叠 */
.emoji-item.k-item {
  width: auto;
  min-width: 110rpx;
  padding: 0 18rpx;
  font-size: 30rpx;
}

.emoji-item:active {
  background: var(--line-soft);
  border-radius: 16rpx;
}

/* 添加面板 */
.panel-add {
  padding: 20rpx 24rpx;
}

.add-grid {
  display: flex;
  justify-content: space-around;
}

.add-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 140rpx;
  padding: 10rpx 0;
}

.add-item:active {
  opacity: 0.6;
}

.add-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 22rpx;
  background-color: var(--line-soft);
  background-repeat: no-repeat;
  background-position: center;
  background-size: 48rpx 48rpx;
}

/* 闲鱼同款「+」面板图标：浅灰圆角方块 + 深灰细线条 */
.add-icon-photo {
  background-image: url("data:image/svg+xml;base64,");
}

.add-icon-video {
  background-image: url("data:image/svg+xml;base64,");
}

.add-icon-location {
  background-image: url("data:image/svg+xml;base64,");
}

.add-text {
  font-size: 24rpx;
  color: var(--ink);
  margin-top: 8rpx;
}

/* ===== 底部语音输入面板（无背景，浮层内容 + 上方遮罩） ===== */
.voice-modal {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: auto;
  z-index: 1000;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  /* 底边位置复原：旧布局内容在 25% 面板盒里垂直居中，这里把那段「下半空白」补进底内边距，
     12.5vh = 旧面板盒（25vh）的一半；120rpx = 半个旧内容高（卡片 2 行 176 + 波形 64）；安全区同样只折半 */
  padding: 28rpx 48rpx calc(28rpx + env(safe-area-inset-bottom));
  padding: 28rpx 48rpx calc(12.5vh - 120rpx + constant(safe-area-inset-bottom) / 2);
  padding: 28rpx 48rpx calc(12.5vh - 120rpx + env(safe-area-inset-bottom) / 2);
  box-sizing: border-box;
  animation: voiceSheetIn 0.25s ease-out;
}

.voice-modal-mask {
  position: absolute;
  /* 面板改为内容自适应高度后，遮罩偏移不能再按面板高度百分比算，直接用视口高度铺满全屏 */
  top: -100vh;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
}

@keyframes voiceSheetIn {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.voice-modal-body {
  position: relative;
  z-index: 1;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 识别文字卡片：淡绿背景呼应小程序主题 */
.voice-card {
  width: 100%;
  max-width: 620rpx;
  background: var(--brand-soft);
  border-radius: 24rpx;
  padding: 20rpx 28rpx 16rpx;
  box-sizing: border-box;
}

.voice-card-processing {
  background: var(--brand-tint-08);
  border: 2rpx solid var(--brand-shadow-20);
}

.voice-card-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.voice-card-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--brand);
  margin-right: 12rpx;
  flex-shrink: 0;
  box-shadow: 0 0 0 5rpx var(--brand-tint-25);
}

.voice-card-dot.pulse {
  animation: voicePulse 1.2s ease-in-out infinite;
}

.voice-card-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--brand);
}

.voice-card-processing .voice-card-title {
  color: var(--ink);
}

/* 实时文字框：可见上限 10 行（30rpx × 1.6 = 48rpx/行）；超出部分由 scroll-top 跟随滚出视野 */
.voice-card-scroll {
  max-height: 480rpx;
  width: 100%;
}

.voice-card-text {
  display: block;
  font-size: 30rpx;
  line-height: 1.6;
  color: var(--ink);
  word-break: break-all;
  white-space: pre-wrap;
}

.voice-card-badge {
  display: inline-block;
  margin-top: 10rpx;
  font-size: 20rpx;
  color: var(--brand);
  background: var(--brand-tint-12);
  border-radius: 18rpx;
  padding: 4rpx 14rpx;
}

/* 音频波形 */
.voice-waves {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin-top: 20rpx;
  height: 44rpx;
}

.voice-wave {
  width: 6rpx;
  border-radius: 3rpx;
  background: var(--brand-shadow-55);
  animation: voiceWave 1s ease-in-out infinite;
}

.voice-wave-1 { height: 18rpx; animation-delay: 0s; }
.voice-wave-2 { height: 30rpx; animation-delay: 0.1s; }
.voice-wave-3 { height: 44rpx; animation-delay: 0.2s; }
.voice-wave-4 { height: 34rpx; animation-delay: 0.3s; }
.voice-wave-5 { height: 44rpx; animation-delay: 0.4s; }
.voice-wave-6 { height: 30rpx; animation-delay: 0.5s; }
.voice-wave-7 { height: 18rpx; animation-delay: 0.6s; }

@keyframes voiceWave {
  0%, 100% { transform: scaleY(0.55); opacity: 0.7; }
  50% { transform: scaleY(1); opacity: 1; }
}

/* 底部提示 */
.voice-modal-footer {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.voice-modal-tip {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--brand);
  letter-spacing: 2rpx;
}

@keyframes voicePulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.35; transform: scale(0.75); }
}

/* 分享弹窗（半屏面板）样式已抽到 components/share-sheet/share-sheet.wxss，与总结结果页共用 */

/* 跨设备分享占位页 */
.share-missing {
  position: fixed;
  inset: 0;
  background: var(--bg);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
}

.share-missing-card {
  background: var(--surface);
  border-radius: 28rpx;
  padding: 64rpx 48rpx;
  width: 100%;
  box-sizing: border-box;
  text-align: center;
}

.share-missing-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.share-missing-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 16rpx;
}

.share-missing-desc {
  font-size: 26rpx;
  color: var(--ink-soft);
  line-height: 1.8;
  margin-bottom: 40rpx;
}

/* ============================================================
   [编辑风增强层] 日记详情
   ============================================================ */
.detail-page,
.edit-page {
  background: var(--bg);
}

.detail-card,
.edit-area {
  background: var(--surface);
  border: 1rpx solid var(--line-soft);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-sm);
}

/* 详情标题：衬线大标 + 琥珀上分隔，杂志内页感 */
.detail-title,
.edit-title-input {
  font-family: var(--font-display);
  font-size: 42rpx;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.35;
  letter-spacing: 1rpx;
}

.detail-content {
  font-size: 30rpx;
  color: var(--ink-mid);
  line-height: 1.95;
  letter-spacing: 0.3rpx;
}

.detail-date,
.detail-meta,
.detail-meta-row,
.detail-location,
.detail-weather {
  color: var(--ink-soft);
  font-size: 24rpx;
  letter-spacing: 0.5rpx;
}

.detail-media-img,
.edit-media-img {
  border-radius: var(--r-md);
}

.btn-danger {
  color: var(--danger);
  border: 1rpx solid var(--danger-tint-25);
  background: transparent;
  /* 重置上方旧实心款残留：圆角对齐 .btn-secondary（--r-pill=8rpx），去掉红色晕影投影 */
  border-radius: var(--r-pill);
  box-shadow: none;
  transition: background var(--dur) var(--ease);
}

.btn-danger:active {
  background: var(--danger-tint-20);
}


.emoji-item {
  transition: background var(--dur) var(--ease);
}

.emoji-item:active {
  background: var(--surface-press);
}

/* 位置卡：统一使用 yl-icon 定位图标（与列表/详情 📍 同一枚字形） */
.loc-icon .ri {
  font-size: 40rpx;
  line-height: 1;
  color: var(--brand);
}

<!-- 日记详情页 -->
<view class="page">
  <!-- 加载中 -->
  <view class="loading" wx:if="{{loading}}">加载中...</view>

  <!-- 查看模式 -->
  <block wx:if="{{diary && !editing}}">
    <view class="detail-card">
      <!-- 标题 -->
      <view class="detail-title">{{diary.title || '无题'}}</view>

      <!-- 日期和标签 -->
      <view class="detail-meta">
        <text class="detail-date">{{diary.createdAt}}</text>
        <view class="detail-tags">
          <text wx:if="{{diary.isAIOptimized}}" class="tag-ai">AI 优化</text>
          <text wx:if="{{diary.moodText}}" class="tag-mood" style="color:{{diary.moodColor}};background:{{diary.moodBg}}">{{diary.moodText}}</text>
          <text wx:for="{{diary.tags}}" wx:for-item="tag" wx:key="*this" class="tag-chip">#{{tag}}</text>
        </view>
      </view>

      <!-- 正文 -->
      <view class="detail-content">{{diary.content}}</view>

      <!-- 位置 & 天气 -->
      <view class="detail-meta-row" wx:if="{{diary.locationText || diary.weatherText}}">
        <text class="detail-location" wx:if="{{diary.locationText}}">📍 {{diary.locationText}}</text>
        <text class="detail-weather" wx:if="{{diary.weatherText}}">{{diary.weatherIcon}} {{diary.weatherText}}</text>
      </view>

      <!-- 媒体：图片网格 + 视频 -->
      <view class="detail-media" wx:if="{{diary.images.length > 0 || diary.videos.length > 0}}">
        <image
          class="detail-media-img"
          wx:for="{{diary.images}}"
          wx:key="*this"
          src="{{item}}"
          mode="aspectFill"
          bindtap="previewMedia"
          data-index="{{index}}"
        />
        <video
          class="detail-media-video"
          wx:for="{{diary.videos}}"
          wx:key="fileID"
          src="{{item.fileID}}"
          poster="{{item.thumb || ''}}"
          object-fit="cover"
          controls="{{true}}"
        />
      </view>
    </view>

    <!-- 操作按钮 -->
    <view class="detail-actions">
      <button class="btn-secondary" bindtap="openSharePanel">分享</button>
      <button class="btn-secondary" bindtap="startEdit">编辑</button>
      <button class="btn-danger" bindtap="deleteDiary">删除</button>
    </view>
  </block>

  <!-- 跨设备分享占位（好友点卡片但本机无数据 / 云端通道未开通时展示） -->
  <view class="share-missing" wx:if="{{shareMissing}}">
    <view class="share-missing-card">
      <view class="share-missing-icon">🔒</view>
      <view class="share-missing-title">日记内容暂不可见</view>
      <view class="share-missing-desc">跨设备查看分享日记的功能即将上线，敬请期待</view>
      <button class="btn-secondary" bindtap="goBackHome">返回</button>
    </view>
  </view>

  <!-- 编辑模式 -->
  <block wx:if="{{diary && editing}}">
    <view class="edit-page">
      <scroll-view class="edit-scroll" scroll-y enhanced show-scrollbar="{{false}}">
        <view class="edit-area" style="padding-top: {{editTop}}px;">
      <view class="section">
        <input
          class="input-field edit-title-input"
          value="{{title}}"
          bindinput="onTitleInput"
          maxlength="50"
          placeholder="标题"
          adjust-position="{{false}}"
          cursor-spacing="20"
        />
      </view>

      <!-- 心情选择 -->
      <view class="section">
        <view class="mood-bar" bindtap="toggleMoodPicker">
          <text class="mood-label">心情</text>
          <text class="mood-value {{moodLabel ? '' : 'placeholder'}}">{{moodLabel || '可选，点击选择'}}</text>
        </view>
        <view class="mood-options" wx:if="{{showMoodPicker}}">
          <view
            class="mood-option {{mood === '' ? 'active' : ''}}"
            data-key="none"
            bindtap="selectMood"
          >不选</view>
          <view
            class="mood-option {{mood === item.key ? 'active' : ''}}"
            wx:for="{{moodOptions}}"
            wx:key="key"
            data-key="{{item.key}}"
            bindtap="selectMood"
          >{{item.label}}</view>
        </view>
      </view>

      <view class="section">
        <textarea
          class="textarea-field"
          value="{{content}}"
          bindinput="onContentInput"
          maxlength="-1"
          auto-height
          show-confirm-bar="{{false}}"
          placeholder="日记内容"
        />
        <view class="char-count">{{content.length}} 字</view>
      </view>

      <!-- 位置（编辑）：带入原位置，可更换/清除 -->
      <view class="section" wx:if="{{editLocation}}">
        <view class="loc-card">
          <view class="loc-icon">
            <view class="pin-ball"></view>
            <view class="pin-hole"></view>
            <view class="pin-tip"></view>
          </view>
          <view class="loc-info">
            <text class="loc-name">{{editLocation.name}}</text>
            <text class="loc-addr" wx:if="{{editLocation.address}}">{{editLocation.address}}</text>
          </view>
          <view class="loc-clear" catchtap="clearEditLocation">✕</view>
        </view>
      </view>

      <!-- 媒体（编辑）：带入原图片/视频，长按拖动排序（与微信朋友圈一致） -->
      <view class="section">
        <view class="edit-media-grid" style="height: {{mediaGridHeight}}px;" wx:if="{{editMedia.length > 0}}">
          <view
            class="edit-media-item {{dragIndex === index ? 'dragging' : ''}}"
            wx:for="{{editMedia}}"
            wx:key="fileID"
            style="transform: translate({{dragIndex === index ? dragPos.left : mediaPositions[index].left}}px, {{dragIndex === index ? dragPos.top : mediaPositions[index].top}}px){{dragIndex === index ? ' scale(1.08)' : ''}};{{dragIndex === index ? 'z-index: 99;' : ''}}"
            bindlongpress="onMediaLongPress"
            catchtouchmove="onMediaTouchMove"
            catchtouchend="onMediaTouchEnd"
            catchtouchcancel="onMediaTouchEnd"
            bindtap="onEditMediaTap"
            data-index="{{index}}"
          >
            <image
              wx:if="{{item.type === 'image'}}"
              class="edit-media-img"
              src="{{item.fileID}}"
              mode="aspectFill"
            />
            <view wx:else class="edit-media-video">
              <video
                class="edit-media-video-inner"
                src="{{item.fileID}}"
                poster="{{item.thumb || ''}}"
                object-fit="cover"
                controls="{{false}}"
                show-center-play-btn="{{false}}"
                enable-progress-gesture="{{false}}"
                autoplay="{{false}}"
              />
              <text class="edit-media-dur">{{item.duration || 0}}s</text>
            </view>
            <view class="edit-media-remove" catchtap="removeEditMedia" data-index="{{index}}">✕</view>
          </view>
        </view>
        <view class="edit-media-tip" wx:if="{{editMedia.length > 0}}">长按图片或视频可拖动排序</view>
      </view>

      <view class="edit-actions">
        <button class="btn-secondary" bindtap="cancelEdit">取消</button>
        <button class="btn-primary" bindtap="saveEdit">保存</button>
      </view>
      <view class="edit-bottom-space"></view>
        </view>
      </scroll-view>

      <!-- 底部输入栏（复用写日记主页底栏所有元素） -->
      <view class="input-bar" style="padding-bottom: calc(22rpx + {{safeAreaBottom}}px);">
        <!-- 表情/颜文字（飞书同款笑脸） -->
        <view class="input-btn input-emoji {{showEmojiPanel ? 'active' : ''}}" bindtap="toggleEmojiPanel">
          <view class="icon-bar icon-smiley"></view>
        </view>

        <!-- 中间区：按住说话（默认语音输入；如需打字，点击上方正文输入区调起系统键盘） -->
        <view class="input-middle">
          <view
            class="hold-talk {{recording ? 'recording' : ''}} {{voiceCanceling ? 'canceling' : ''}}"
            bindtouchstart="onHoldStart"
            bindtouchend="onHoldEnd"
            bindtouchcancel="onHoldEnd"
            bindtouchmove="onVoiceTouchMove"
          >{{voiceCanceling ? '松开取消' : (recording ? '松开 结束' : (connecting ? '连接中…' : '按住 说话'))}}</view>
        </view>

        <!-- 添加(+)：图片 / 视频 / 位置 -->
        <view
          class="input-add {{showAddPanel ? 'active' : ''}}"
          bindtap="onAddOrSend"
        >
          <view class="icon-bar icon-plus"></view>
        </view>
      </view>

      <!-- 表情/颜文字面板 -->
      <view class="panel panel-emoji" wx:if="{{showEmojiPanel}}" style="padding-bottom: {{safeAreaBottom}}px;">
        <view class="panel-tabs">
          <view class="panel-tab {{emojiTab === 'emoji' ? 'active' : ''}}" bindtap="switchEmojiTab" data-tab="emoji">表情</view>
          <view class="panel-tab {{emojiTab === 'kaomoji' ? 'active' : ''}}" bindtap="switchEmojiTab" data-tab="kaomoji">颜文字</view>
        </view>
        <scroll-view class="emoji-scroll" scroll-y>
          <view class="emoji-grid">
            <view class="emoji-item {{emojiTab === 'kaomoji' ? 'k-item' : ''}}" wx:for="{{emojiList}}" wx:key="*this" bindtap="insertEmoji" data-emoji="{{item}}">{{item}}</view>
          </view>
        </scroll-view>
      </view>

      <!-- 添加面板：图片 / 视频 / 位置 -->
      <view class="panel panel-add" wx:if="{{showAddPanel}}" style="padding-bottom: {{safeAreaBottom}}px;">
        <view class="add-grid">
          <view class="add-item" bindtap="chooseEditImage">
            <view class="add-icon add-icon-photo"></view>
            <text class="add-text">图片</text>
          </view>
          <view class="add-item" bindtap="chooseEditVideo">
            <view class="add-icon add-icon-video"></view>
            <text class="add-text">视频</text>
          </view>
          <view class="add-item" bindtap="chooseEditLocation">
            <view class="add-icon add-icon-location"></view>
            <text class="add-text">位置</text>
          </view>
        </view>
      </view>

      <!-- 全屏语音输入面板（飞书风格 + 小程序绿色主题） -->
      <view class="voice-modal" wx:if="{{recording || transcribing}}">
        <view class="voice-modal-mask"></view>
        <view class="voice-modal-body">
          <view class="voice-card {{recording ? '' : 'voice-card-processing'}}">
            <view class="voice-card-header">
              <view class="voice-card-dot {{recording ? 'pulse' : ''}}"></view>
              <text class="voice-card-title">{{transcribing ? '语音识别中' : '正在聆听'}}</text>
            </view>
            <scroll-view class="voice-card-scroll" scroll-y scroll-top="{{liveScrollTop}}" enhanced show-scrollbar="{{false}}">
              <text class="voice-card-text">{{liveText || (recording ? '请说话…' : '识别中…')}}</text>
            </scroll-view>
            <view class="voice-card-badge" wx:if="{{liveRemoved > 0}}">已过滤 {{liveRemoved}} 处语气词</view>
          </view>

          <view class="voice-waves" wx:if="{{recording}}">
            <view class="voice-wave voice-wave-1"></view>
            <view class="voice-wave voice-wave-2"></view>
            <view class="voice-wave voice-wave-3"></view>
            <view class="voice-wave voice-wave-4"></view>
            <view class="voice-wave voice-wave-5"></view>
            <view class="voice-wave voice-wave-6"></view>
            <view class="voice-wave voice-wave-7"></view>
          </view>
        </view>

        <view class="voice-modal-footer">
          <text class="voice-modal-tip" wx:if="{{voiceCanceling || transcribing}}">{{voiceCanceling ? '松开取消发送' : '处理中…'}}</text>
        </view>
      </view>
    </view>
  </block>

  <!-- ===== 分享弹窗（半屏面板） ===== -->
  <view class="share-mask" wx:if="{{showSharePanel}}" bindtap="closeSharePanel" catchtouchmove="preventTouchMove"></view>
  <view class="share-sheet" wx:if="{{showSharePanel}}">
    <view class="share-grab"></view>
    <scroll-view scroll-y class="share-scroll" show-scrollbar="{{false}}">
      <view class="share-title">分享我的日记</view>

      <!-- 私密分享 -->
      <view class="share-sec-head">
        <text class="share-sec-title">🔒 私密分享</text>
        <text class="share-sec-sub">仅微信好友可见完整内容</text>
      </view>
      <button class="share-row share-row-plain" open-type="share">
        <view class="share-row-icon share-row-icon-chat">
          <image class="share-icon-wechat" src="/pages/detail/images/wechat.png" mode="aspectFit" />
        </view>
        <view class="share-row-main">
          <text class="share-row-name">以卡片形式直接发送</text>
        </view>
      </button>

      <!-- 公开分享 -->
      <view class="share-sec-head share-sec-head-gap">
        <text class="share-sec-title">🌐 公开分享</text>
        <text class="share-sec-sub">生成海报，可发朋友圈/小红书/微博等</text>
      </view>
      <view class="share-row {{shareAction === 'poster' ? 'active' : ''}}" bindtap="selectShareAction" data-action="poster">
        <view class="share-row-icon share-row-icon-poster">
          <image class="share-icon-img" src="/pages/detail/images/poster.png" mode="aspectFit" />
        </view>
        <view class="share-row-main">
          <text class="share-row-name">保存分享海报</text>
          <text class="share-row-desc">图文卡片，保存到相册</text>
        </view>
      </view>
      <view class="share-row {{shareAction === 'text' ? 'active' : ''}}" bindtap="selectShareAction" data-action="text">
        <view class="share-row-icon share-row-icon-text">📝</view>
        <view class="share-row-main">
          <text class="share-row-name">复制精简文字</text>
          <text class="share-row-desc">已脱敏，适配各平台粘贴</text>
        </view>
      </view>

      <!-- 自定义展示开关（公开海报专属，横排精简） -->
      <view class="share-sec-head share-sec-head-gap">
        <text class="share-sec-title">自定义展示开关</text>
        <text class="share-sec-sub">公开海报专属</text>
      </view>
      <view class="share-sw-grid">
        <view class="share-sw-item">
          <text class="share-sw-label">天气</text>
          <switch checked="{{shareSw.weather}}" color="#07C160" data-key="weather" bindchange="toggleShareSwitch" />
        </view>
        <view class="share-sw-item">
          <text class="share-sw-label">心情</text>
          <switch checked="{{shareSw.mood}}" color="#07C160" data-key="mood" bindchange="toggleShareSwitch" />
        </view>
        <view class="share-sw-item">
          <text class="share-sw-label">标签</text>
          <switch checked="{{shareSw.tags}}" color="#07C160" data-key="tags" bindchange="toggleShareSwitch" />
        </view>
        <view class="share-sw-item">
          <text class="share-sw-label">图片</text>
          <switch checked="{{shareSw.images}}" color="#07C160" data-key="images" bindchange="toggleShareSwitch" />
        </view>
      </view>

      <view class="share-disclaimer">公开海报仅展示内容摘要，隐私细节已隐藏，对外分享请自行确认内容哦</view>
    </scroll-view>

    <view class="share-btns" style="padding-bottom: {{safeAreaBottom + 8}}px;">
      <button class="share-btn-cancel" bindtap="closeSharePanel">取消</button>
      <button class="share-btn-ok" bindtap="confirmShare">确认分享</button>
    </view>
  </view>

  <!-- 海报画布（离屏，2d） -->
  <canvas type="2d" id="sharePosterCanvas" class="share-poster-canvas"></canvas>
</view>

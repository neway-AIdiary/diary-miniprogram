/* ===== 我的：微信小程序标准 cell 列表风格 · 浅青绿底 ===== */
.page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 60rpx;
  box-sizing: border-box;
}

/* 用户卡片：白色圆角卡片 */
.user-card {
  background: var(--surface);
  border-radius: 16rpx;
  margin: 24rpx 24rpx 0;
  padding: 40rpx 36rpx;
  display: flex;
  align-items: center;
}

.user-avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: var(--bg-soft);
}

.user-info {
  margin-left: 32rpx;
  flex: 1;
}

.user-name {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--ink);
}

.user-desc {
  font-size: 24rpx;
  color: var(--ink-soft);
  margin-top: 10rpx;
}

.user-login {
  display: flex;
  align-items: center;
  width: 100%;
}

.user-avatar-default {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: var(--bg-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  color: var(--brand-mute);
  flex-shrink: 0;
}

.user-login-text {
  font-size: 32rpx;
  color: var(--ink);
  margin-left: 32rpx;
  font-weight: 500;
}

/* 统计卡片 */
.stats-section {
  padding: 0 24rpx;
  margin-top: 24rpx;
}

.stats-card {
  background: var(--surface);
  border-radius: 16rpx;
  padding: 36rpx 24rpx;
}

.stats-row {
  display: flex;
  justify-content: space-around;
}

.stat-block {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-block .stat-num {
  font-size: 44rpx;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.2;
}

.stat-block .stat-label {
  font-size: 22rpx;
  color: var(--ink-soft);
  margin-top: 10rpx;
}

.stats-row + .stats-row {
  margin-top: 28rpx;
  justify-content: center;
}

.streak-badge {
  font-size: 24rpx;
  color: var(--surface);
  background: linear-gradient(135deg, var(--brand-bright) 0%, var(--brand) 100%);
  padding: 10rpx 32rpx;
  border-radius: 40rpx;
  box-shadow: 0 6rpx 16rpx var(--brand-shadow-28);
}

/* 菜单：微信标准 cell 分组列表 */
.menu-section {
  padding: 0 24rpx;
  margin-top: 32rpx;
}

.menu-title {
  font-size: 24rpx;
  color: var(--ink-soft);
  padding: 0 8rpx 16rpx;
}

.menu-card {
  background: var(--surface);
  border-radius: 16rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid var(--line);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background: var(--bg-soft);
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: var(--ink);
}

.menu-text.danger {
  color: var(--danger);
}

.menu-arrow {
  font-size: 36rpx;
  color: var(--ink-faint);
  line-height: 1;
}

/* 底部 */
.footer {
  text-align: center;
  padding: 64rpx 0 40rpx;
}

.footer-text {
  font-size: 24rpx;
  color: var(--ink-soft);
}

.footer-sub {
  font-size: 22rpx;
  color: var(--ink-faint);
  margin-top: 10rpx;
}

/* ===== 云端备份 ===== */
.backup-hint {
  padding: 16rpx 32rpx 0;
  font-size: 22rpx;
  color: var(--ink-soft);
  line-height: 1.7;
  white-space: pre-line;
}

/* 备份密码弹框（与档案页编辑弹框同风格） */
.backup-modal {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1100;
  display: flex;
  align-items: center;
  justify-content: center;
}

.backup-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
}

.backup-card {
  position: relative;
  z-index: 1;
  width: 640rpx;
  background: var(--surface);
  border-radius: 24rpx;
  padding: 40rpx 36rpx 32rpx;
  box-sizing: border-box;
}

.backup-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ink);
  text-align: center;
  margin-bottom: 20rpx;
}

.backup-desc {
  font-size: 24rpx;
  color: var(--ink-soft);
  line-height: 1.7;
  margin-bottom: 24rpx;
}

.backup-input {
  width: 100%;
  box-sizing: border-box;
  height: 80rpx;
  background: var(--line-soft);
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: var(--ink);
  margin-bottom: 20rpx;
}

.backup-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}

.backup-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
}

.backup-btn.cancel {
  background: var(--line-soft);
  color: var(--ink-mid);
}

.backup-btn.cancel:active {
  opacity: 0.7;
}

.backup-btn.ok {
  background: var(--brand);
  color: var(--surface);
  font-weight: 500;
}

.backup-btn.ok:active {
  background: var(--brand);
}

/* ============================================================
   [编辑风增强层] 个人中心
   ============================================================ */
.user-card {
  background: var(--surface);
  border: 1rpx solid var(--line-soft);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-sm);
}

.user-name {
  font-family: var(--font-display);
  font-size: 38rpx;
  font-weight: 600;
  color: var(--ink);
  letter-spacing: 1rpx;
}

.user-desc,
.user-login-text {
  color: var(--ink-soft);
  font-size: 24rpx;
}

.user-avatar,
.user-avatar-default {
  border: 1rpx solid var(--line);
  box-shadow: none;
}

.streak-badge {
  background: var(--brand-tint-12);
  color: var(--brand);
  border: 1rpx solid var(--brand-tint-25);
}

.stats-card,
.menu-card,
.backup-card {
  background: var(--surface);
  border: 1rpx solid var(--line-soft);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-sm);
}

.stat-block {
  font-family: var(--font-display);
}

.menu-section,
.privacy-title,
.backup-title {
  font-family: var(--font-display);
  font-size: 26rpx;
  color: var(--ink-soft);
  letter-spacing: 2rpx;
}

.menu-item {
  transition: background var(--dur) var(--ease);
}

.menu-item:active {
  background: var(--surface-press);
}

.menu-arrow {
  color: var(--ink-faint);
}

.footer-text,
.footer-sub {
  color: var(--ink-faint);
  font-size: 22rpx;
  letter-spacing: 1rpx;
}

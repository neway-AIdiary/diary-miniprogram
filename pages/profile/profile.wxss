/* ===== 我的：微信小程序标准 cell 列表风格 · 浅青绿底 ===== */
.page {
  min-height: 100vh;
  background: #F0F6F2;
  padding-bottom: 60rpx;
  box-sizing: border-box;
}

/* 用户卡片：白色圆角卡片 */
.user-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  margin: 24rpx 24rpx 0;
  padding: 40rpx 36rpx;
  display: flex;
  align-items: center;
}

.user-avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #EAF3EE;
}

.user-info {
  margin-left: 32rpx;
  flex: 1;
}

.user-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.user-desc {
  font-size: 24rpx;
  color: #999999;
  margin-top: 10rpx;
}

.user-login {
  display: flex;
  align-items: center;
  width: 100%;
}

.user-avatar-default {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: #EAF3EE;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  color: #7FB89B;
  flex-shrink: 0;
}

.user-login-text {
  font-size: 32rpx;
  color: #1A1A1A;
  margin-left: 32rpx;
  font-weight: 500;
}

/* 统计卡片 */
.stats-section {
  padding: 0 24rpx;
  margin-top: 24rpx;
}

.stats-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 36rpx 24rpx;
}

.stats-row {
  display: flex;
  justify-content: space-around;
}

.stat-block {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-block .stat-num {
  font-size: 44rpx;
  font-weight: 600;
  color: #1A1A1A;
  line-height: 1.2;
}

.stat-block .stat-label {
  font-size: 22rpx;
  color: #999999;
  margin-top: 10rpx;
}

.stats-row + .stats-row {
  margin-top: 28rpx;
  justify-content: center;
}

.streak-badge {
  font-size: 24rpx;
  color: #FFFFFF;
  background: linear-gradient(135deg, #FFC04D 0%, #FF9500 100%);
  padding: 10rpx 32rpx;
  border-radius: 40rpx;
  box-shadow: 0 6rpx 16rpx rgba(255, 149, 0, 0.28);
}

/* 菜单：微信标准 cell 分组列表 */
.menu-section {
  padding: 0 24rpx;
  margin-top: 32rpx;
}

.menu-title {
  font-size: 24rpx;
  color: #999999;
  padding: 0 8rpx 16rpx;
}

.menu-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #EBEBEB;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background: #F5FAF7;
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: #1A1A1A;
}

.menu-text.danger {
  color: #FA5151;
}

.menu-arrow {
  font-size: 36rpx;
  color: #C0C0C0;
  line-height: 1;
}

/* 底部 */
.footer {
  text-align: center;
  padding: 64rpx 0 40rpx;
}

.footer-text {
  font-size: 24rpx;
  color: #999999;
}

.footer-sub {
  font-size: 22rpx;
  color: #BBBBBB;
  margin-top: 10rpx;
}

/* ===== 云端备份 ===== */
.backup-hint {
  padding: 16rpx 32rpx 0;
  font-size: 22rpx;
  color: #999999;
  line-height: 1.7;
  white-space: pre-line;
}

/* 备份密码弹框（与档案页编辑弹框同风格） */
.backup-modal {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1100;
  display: flex;
  align-items: center;
  justify-content: center;
}

.backup-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
}

.backup-card {
  position: relative;
  z-index: 1;
  width: 640rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 40rpx 36rpx 32rpx;
  box-sizing: border-box;
}

.backup-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1A;
  text-align: center;
  margin-bottom: 20rpx;
}

.backup-desc {
  font-size: 24rpx;
  color: #888888;
  line-height: 1.7;
  margin-bottom: 24rpx;
}

.backup-input {
  width: 100%;
  box-sizing: border-box;
  height: 80rpx;
  background: #F2F3F5;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #1A1A1A;
  margin-bottom: 20rpx;
}

.backup-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}

.backup-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
}

.backup-btn.cancel {
  background: #F2F3F5;
  color: #666666;
}

.backup-btn.cancel:active {
  opacity: 0.7;
}

.backup-btn.ok {
  background: #07C160;
  color: #FFFFFF;
  font-weight: 500;
}

.backup-btn.ok:active {
  background: #06AD56;
}

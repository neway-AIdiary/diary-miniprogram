}

.s-menu-item.danger .s-menu-text {
  color: var(--danger);
}

.s-arrow {
  font-size: 30rpx;
  color: var(--ink-faint);
}

/* 档案：文档 */
.icon-archive::before {
  width: 22rpx;
  height: 28rpx;
  border: 4rpx solid currentColor;
  border-radius: 5rpx;
  left: 13rpx;
  top: 10rpx;
}

.icon-archive::after {
  width: 12rpx;
  height: 4rpx;
  background: currentColor;
  border-radius: 2rpx;
  left: 18rpx;
  top: 18rpx;
  box-shadow: 0 8rpx 0 currentColor;
}

/* 导出 / 导入：共用托盘 */
.icon-export .i-arrow-up,
.icon-import .i-arrow-down {
  position: absolute;
  left: 50%;
  top: 12rpx;
  transform: translateX(-50%);
  width: 4rpx;
  height: 12rpx;
  background: currentColor;
  border-radius: 2rpx;
}

.icon-export .i-arrow-up::after {
  content: '';
  position: absolute;
  top: -8rpx;
  left: 50%;
  transform: translateX(-50%);
  border-left: 5rpx solid transparent;
  border-right: 5rpx solid transparent;
  border-bottom: 8rpx solid currentColor;
}

.icon-import .i-arrow-down::after {
  content: '';
  position: absolute;
  bottom: -8rpx;
  left: 50%;
  transform: translateX(-50%);
  border-left: 5rpx solid transparent;
  border-right: 5rpx solid transparent;
  border-top: 8rpx solid currentColor;
}

.icon-export .i-tray,
.icon-import .i-tray {
  position: absolute;
  left: 50%;
  top: 26rpx;
  transform: translateX(-50%);
  width: 26rpx;
  height: 12rpx;
  border: 4rpx solid currentColor;
  border-top: none;
  border-radius: 0 0 5rpx 5rpx;
}

/* 关于：信息 i */
.icon-about::before {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: currentColor;
  left: 20rpx;
  top: 12rpx;
}

.icon-about::after {
  width: 6rpx;
  height: 16rpx;
  border-radius: 3rpx;
  background: currentColor;
  left: 21rpx;
  top: 24rpx;
}

/* 设置：齿轮（中心圆 + 上下左右四齿） */
.icon-setting::before {
  width: 20rpx;
  height: 20rpx;
  border: 4rpx solid currentColor;
  border-radius: 50%;
  left: 14rpx;
  top: 14rpx;
}

.icon-setting::after {
  width: 6rpx;
  height: 6rpx;
  background: currentColor;
  border-radius: 2rpx;
  left: 21rpx;
  top: 5rpx;
  box-shadow:
    0 32rpx 0 currentColor,
    -16rpx 16rpx 0 currentColor,
    16rpx 16rpx 0 currentColor;
}

/* 清除：垃圾桶 */
.icon-clear::before {
  width: 20rpx;
  height: 20rpx;
  border: 4rpx solid currentColor;
  border-top: none;
  border-radius: 0 0 5rpx 5rpx;
  left: 14rpx;
  top: 16rpx;
}

.icon-clear::after {
  width: 14rpx;
  height: 8rpx;
  border: 4rpx solid currentColor;
  border-bottom: none;
  border-radius: 5rpx 5rpx 0 0;
  left: 17rpx;
  top: 8rpx;
}

/* 智能总结：四角星（sparkle）+ 中心点 */
.icon-summary::before {
  width: 20rpx;
  height: 20rpx;
  border: 4rpx solid currentColor;
  border-radius: 3rpx;
  transform: rotate(45deg);
  left: 14rpx;
  top: 14rpx;
}

.icon-summary::after {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: currentColor;
  left: 21rpx;
  top: 21rpx;
}

/* 云端备份：云朵 + 向上箭头 */
.icon-backup::before {
  width: 28rpx;
  height: 14rpx;
  border: 4rpx solid currentColor;
  border-radius: 8rpx;
  left: 10rpx;
  top: 24rpx;
}

.icon-backup::after {
  width: 4rpx;
  height: 14rpx;
  border-radius: 2rpx;
  background: currentColor;
  left: 22rpx;
  top: 12rpx;
}

.icon-backup .i-arrow-up {
  position: absolute;
  left: 18rpx;
  top: 12rpx;
  width: 12rpx;
  height: 12rpx;
  border-left: 4rpx solid currentColor;
  border-top: 4rpx solid currentColor;
  border-top-left-radius: 2rpx;
  transform: rotate(45deg);
}

/* ===== 底部语音输入面板（无背景，浮层内容 + 上方遮罩） ===== */
.voice-modal {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: auto;
  z-index: 1000;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  /* 底边位置复原：旧布局内容在 25% 面板盒里垂直居中，这里把那段「下半空白」补进底内边距，
     12.5vh = 旧面板盒（25vh）的一半；120rpx = 半个旧内容高（卡片 2 行 176 + 波形 64）；安全区同样只折半 */
  padding: 28rpx 48rpx calc(28rpx + env(safe-area-inset-bottom));
  padding: 28rpx 48rpx calc(12.5vh - 120rpx + constant(safe-area-inset-bottom) / 2);
  padding: 28rpx 48rpx calc(12.5vh - 120rpx + env(safe-area-inset-bottom) / 2);
  box-sizing: border-box;
  animation: voiceSheetIn 0.25s ease-out;
}

.voice-modal-mask {
  position: absolute;
  /* 面板改为内容自适应高度后，遮罩偏移不能再按面板高度百分比算，直接用视口高度铺满全屏 */
  top: -100vh;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
}

@keyframes voiceSheetIn {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.voice-modal-body {
  position: relative;
  z-index: 1;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 识别文字卡片：淡绿背景呼应小程序主题 */
.voice-card {
  width: 100%;
  max-width: 620rpx;
  background: var(--brand-soft);
  border-radius: 24rpx;
  padding: 20rpx 28rpx 16rpx;
  box-sizing: border-box;
}

.voice-card-processing {
  background: var(--brand-tint-08);
  border: 2rpx solid var(--brand-shadow-20);
}

.voice-card-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.voice-card-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--brand);
  margin-right: 12rpx;
  flex-shrink: 0;
  box-shadow: 0 0 0 5rpx var(--brand-tint-25);
}

.voice-card-dot.pulse {
  animation: voicePulse 1.2s ease-in-out infinite;
}

.voice-card-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--brand);
}

.voice-card-processing .voice-card-title {
  color: var(--ink);
}

/* 实时文字框：可见上限 10 行（30rpx × 1.6 = 48rpx/行）；超出部分由 scroll-top 跟随滚出视野 */
.voice-card-scroll {
  max-height: 480rpx;
  width: 100%;
}

.voice-card-text {
  display: block;
  font-family: var(--content-font);
  font-size: var(--content-size);
  line-height: 1.6;
  color: var(--ink);
  word-break: break-all;
  white-space: pre-wrap;
}

.voice-card-badge {
  display: inline-block;
  margin-top: 10rpx;
  font-size: 20rpx;
  color: var(--brand);
  background: var(--brand-tint-12);
  border-radius: 18rpx;
  padding: 4rpx 14rpx;
}

/* 音频波形 */
.voice-waves {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin-top: 20rpx;
  height: 44rpx;
}

.voice-wave {
  width: 6rpx;
  border-radius: 3rpx;
  background: var(--brand-shadow-55);
  animation: voiceWave 1s ease-in-out infinite;
}

.voice-wave-1 { height: 18rpx; animation-delay: 0s; }
.voice-wave-2 { height: 30rpx; animation-delay: 0.1s; }
.voice-wave-3 { height: 44rpx; animation-delay: 0.2s; }
.voice-wave-4 { height: 34rpx; animation-delay: 0.3s; }
.voice-wave-5 { height: 44rpx; animation-delay: 0.4s; }
.voice-wave-6 { height: 30rpx; animation-delay: 0.5s; }
.voice-wave-7 { height: 18rpx; animation-delay: 0.6s; }

@keyframes voiceWave {
  0%, 100% { transform: scaleY(0.55); opacity: 0.7; }
  50% { transform: scaleY(1); opacity: 1; }
}

/* 底部提示 */
.voice-modal-footer {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.voice-modal-tip {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--brand);
  letter-spacing: 2rpx;
}

@keyframes voicePulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.35; transform: scale(0.75); }
}

/* ===== AI优化中 ===== */
.optimize-loading {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--surface-frost);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.opt-loading-text {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--ink);
  margin-bottom: 12rpx;
}

.opt-loading-subtext {
  font-size: 26rpx;
  color: var(--ink-soft);
  margin-bottom: 48rpx;
}

.gen-dots {
  display: flex;
  gap: 16rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--ai);
  animation: bounce 1.4s ease-in-out infinite;
}

.dot1 { animation-delay: 0s; }
.dot2 { animation-delay: 0.2s; }
.dot3 { animation-delay: 0.4s; }

@keyframes bounce {
  0%, 80%, 100% { transform: scale(0.6); opacity: 0.4; }
  40% { transform: scale(1); opacity: 1; }
}

/* ===== AI优化结果 =====
   锁死整层（flex column + overflow hidden）：
   - 导航条（左返回/中标题）+ 内容区 + 底部按钮三段式
   - 文本框：flex:1 占满剩余空间，内容超出时框内滚动
   - 底部按钮：flex-shrink:0 固定在底部，与总结结果页底部按钮位置一致
   内边距由 .opt-content 提供（32rpx），导航条通栏、顶部状态栏高度由 inline style 提供 */
.optimize-result {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: var(--surface);
  z-index: 90;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* 面板导航条：规格与写日记页自绘导航栏一致（88rpx 高、标题绝对居中 34rpx/600） */
.opt-nav {
  flex-shrink: 0;
  height: 88rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  position: relative;
}

.opt-nav-left {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  border-radius: 16rpx;
}

/* 返回箭头：CSS 画的双线尖括号（对齐原生返回键观感） */
.opt-nav-back {
  width: 22rpx;
  height: 22rpx;
  border-left: 4rpx solid var(--ink);
  border-bottom: 4rpx solid var(--ink);
  transform: rotate(45deg);
  margin-left: 12rpx;
}

.opt-nav-title {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  font-size: var(--title-2);
  font-weight: var(--title-w);
  color: var(--title-ink);
  font-family: var(--font-display);
  letter-spacing: var(--title-track);
}

/* 右侧 88rpx 占位：避让小程序胶囊按钮（···/◎），不放任何功能 */
.opt-nav-right {
  width: 88rpx;
  height: 88rpx;
}

/* 面板内容区：承接原 32rpx 内边距 */
.opt-content {
  flex: 1 1 auto;
  min-height: 0;
  display: flex;
  flex-direction: column;
  padding: 8rpx 32rpx 0;
}

.opt-points {
  background: var(--bg-soft);
  border-radius: 12rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
  flex-shrink: 0;
  /* 要点条目多时内部滚动，避免挤压下方文本框 */
  max-height: 240rpx;
  overflow-y: auto;
}

.opt-points-title {
  font-size: var(--title-3);
  color: var(--title-ink-3);
  font-family: var(--font-display);
  font-weight: var(--title-w-3);
  letter-spacing: var(--title-track-3);
  margin-bottom: 14rpx;
}

.opt-point {
  font-size: 26rpx;
  color: var(--ink-mid);
  line-height: 1.8;
}

.opt-original-toggle {
  font-size: 26rpx;
  color: var(--ink-soft);
  padding: 8rpx 0;
  margin-bottom: 8rpx;
  flex-shrink: 0;
}

.opt-original-content {
  font-size: 26rpx;
  color: var(--ink-soft);
  background: var(--bg-soft);
  border-radius: 12rpx;
  padding: 24rpx 28rpx;
  line-height: 1.8;
  margin-bottom: 24rpx;
  white-space: pre-wrap;
  word-wrap: break-word;
  max-height: 300rpx;
  overflow-y: auto;
  flex-shrink: 0;
}

.opt-label {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--ink);
  margin-bottom: 16rpx;
  flex-shrink: 0;
}

/* 文本框外层：占满剩余高度（父链有确定高度，textarea height:100% 可解析） */
.opt-input-wrap {
  flex: 1 1 auto;
  min-height: 0;
}

.opt-textarea {
  height: 100%;
  min-height: 0;
  border: 1rpx solid var(--line);
}

.opt-btns {
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
  flex-shrink: 0;
  /* 底部间距对齐总结结果页（页面 padding 32 + 此处 16 = 48rpx），并留出底部安全区 */
  padding-bottom: 16rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}

/* 三按钮等分：去掉左右内边距（默认 48rpx 会把「重新优化」挤折行），文字强制一行 */
.opt-btns button {
  flex: 1;
  padding-left: 0;
  padding-right: 0;
  white-space: nowrap;
}

/* ===== 实体备案弹窗 ===== */
.entity-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.entity-modal {
  width: 600rpx;
  background: var(--surface);
  border-radius: 24rpx;
  padding: 40rpx 32rpx 32rpx;
}

.entity-title {
  font-size: var(--title-2);
  font-weight: var(--title-w);
  color: var(--title-ink);
  font-family: var(--font-display);
  letter-spacing: var(--title-track);
  text-align: center;
  margin-bottom: 12rpx;
}

.entity-desc {
  font-size: 26rpx;
  color: var(--ink-soft);
  text-align: center;
  margin-bottom: 28rpx;
}

.entity-list {
  max-height: 500rpx;
  overflow-y: auto;
}

.entity-item {
  display: flex;
  align-items: center;
  padding: 20rpx 16rpx;
  border-bottom: 1rpx solid var(--line-soft);
}

.entity-item.checked {
  background: var(--bg);
  border-radius: 12rpx;
}

.entity-checkbox {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid var(--ink-faint);
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--brand-mute);
  margin-right: 20rpx;
  flex-shrink: 0;
}

.entity-item.checked .entity-checkbox {
  border-color: var(--brand-mute);
  background: var(--brand-mute);
  color: var(--surface);
}

.entity-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  flex: 1;
  min-width: 0;
}

.entity-name-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.entity-name {
  font-size: 30rpx;
  color: var(--ink);
  font-weight: 500;
}

.entity-desc-text {
  font-size: 24rpx;
  color: var(--ink-soft);
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.entity-type {
  font-size: 22rpx;
  color: var(--ink-soft);
  background: var(--line-soft);
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}

/* 已备案名词标记：解释相同（灰）/ 解释有更新（绿） */
.entity-exist {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-left: 8rpx;
}

.entity-exist.same {
  color: var(--ink-soft);
  background: var(--line-soft);
}

.entity-exist.diff {
  color: var(--brand);
  background: var(--brand-soft);
}

.entity-btns {
  display: flex;
  gap: 24rpx;
  margin-top: 32rpx;
}

.entity-btns button {
  flex: 1;
}

/* ============================================================
   [编辑风增强层] 写日记
   ============================================================ */
.diary-card {
  background: var(--surface);
  border: 1rpx solid var(--line-soft);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-sm);
}

/* 正文输入：衬线体，写日记更像在纸上书写 */
.diary-textarea {
  font-family: var(--content-font);
  font-size: var(--content-size);
  color: var(--ink);
  line-height: 1.95;
  letter-spacing: 0.3rpx;
}

.diary-placeholder {
  color: var(--ink-faint);
}

/* 日历：杂志小开本 */
.cal-title {
  font-family: var(--font-display);
  font-size: var(--title-2);
  font-weight: var(--title-w);
  color: var(--title-ink);
  letter-spacing: var(--title-track);
}

.cal-week {
  color: var(--ink-faint);
  font-size: 22rpx;
  letter-spacing: 1rpx;
}

.cal-cell {
  color: var(--ink-mid);
  transition: background var(--dur) var(--ease);
}

.date-pill {
  background: var(--bg-soft);
  color: var(--ink);
  border: 1rpx solid var(--line-soft);
  transition: border-color var(--dur) var(--ease), color var(--dur) var(--ease);
}

.date-pill:active {
  border-color: var(--brand);
  color: var(--brand);
}

/* 底部工具条：发丝线上浮，琥珀高亮 */
.input-bar {
  background: var(--surface-frost);
  border-top: 1rpx solid var(--line-soft);
}

.icon-mic,
.icon-smiley,
.icon-plus,
.icon-keyboard {
  color: var(--ink-mid);
  transition: color var(--dur) var(--ease), transform var(--dur) var(--ease);
}

.icon-mic:active,
.icon-smiley:active,
.icon-plus:active,
.icon-keyboard:active {
  color: var(--brand);
  transform: scale(0.94);
}

.add-item {
  transition: background var(--dur) var(--ease);
}

.add-item:active {
  background: var(--surface-press);
}

.add-text {
  color: var(--ink-mid);
  font-size: 24rpx;
}

.char-count {
  color: var(--ink-faint);
  font-size: 22rpx;
  letter-spacing: 0.5rpx;
}

.emoji-item:active {
  background: var(--surface-press);
}

/* 位置卡：统一使用 yl-icon 定位图标（与列表/详情 📍 同一枚字形） */
.loc-icon .ri {
  font-size: 40rpx;
  line-height: 1;
  color: var(--brand);
}


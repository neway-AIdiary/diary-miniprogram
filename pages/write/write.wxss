/* ===== 写日记：微信聊天风格 ===== */
.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--bg);
  overflow: hidden;
}

/* ===== 自定义导航栏 ===== */
.nav-bar {
  flex-shrink: 0;
  background: var(--bg);
}

.nav-inner {
  height: 88rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  position: relative;
}

.nav-left {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  border-radius: 16rpx;
}

.nav-btn-hover {
  opacity: 0.6;
}

/* 双横杠菜单图标 */
.nav-lines {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding: 14rpx;
}

.nav-line {
  width: 40rpx;
  height: 5rpx;
  border-radius: 4rpx;
  background: var(--ink);
}

.nav-title {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  font-size: var(--title-2);
  font-weight: var(--title-w);
  color: var(--title-ink);
  font-family: var(--font-display);
  letter-spacing: var(--title-track);
}

.nav-right {
  width: 88rpx;
  height: 88rpx;
}

/* ===== 主内容区 ===== */
.content-scroll {
  flex: 1;
  min-height: 0;
  /* 普通 view（非 scroll-view）：定高 + 裁剪，让高度约束能传给 content-inner 和卡片。
     不用 scroll-view 是因为滚动容器不压缩子元素，flex 收缩链会断掉 */
  overflow: hidden;
  padding: 0 24rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  /* 抬到 tech-credit（左下角说明文字）之上：正文卡片/工具行可压盖说明文字 */
  position: relative;
  z-index: 1;
}

/* 滚动内容统一内层：内容不足一屏时仍撑满滚动区，避免底部留白不自然 */
.content-inner {
  display: flex;
  flex-direction: column;
  /* 可用高度变成硬约束：卡片超出时收缩到上限、内部滚动，按钮行永远不会被内容顶出屏幕。
     父级已改为普通 view，这里的 height:100% 才真正生效（在 scroll-view 内会被忽略） */
  height: 100%;
  flex: 1 1 auto;
  min-height: 0;
  box-sizing: border-box;
  /* 按钮行停稳位置 = 本底留白：值越大按钮越高，值越小越贴近屏幕底部（用户指定 190rpx）。
     190rpx 略高于输入栏上沿（114rpx + 底部安全区，iPhone X 类约 182rpx），留出余量不贴住；
     左下角「技术支持说明」底距 136rpx + 字高 26rpx，亦不会被压到 */
  padding-bottom: 190rpx;
}

/* 日期（可选择）+ 心情（可选择）+ 天气（纯展示）：左侧日期/心情固定相邻，天气靠右 */
.date-wrap {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx 24rpx;
  background: var(--bg);
}

.date-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-shrink: 0;
}

.date-pill {
  background: rgba(0, 0, 0, 0.06);
  border-radius: 30rpx;
  padding: 10rpx 28rpx;
  font-size: 24rpx;
  color: var(--ink-soft);
}

/* 图标与日期文字间距（原仅靠空格 ≈6rpx，太贴） */
.date-pill .ri {
  margin-right: 10rpx;
}

/* 日期/心情胶囊按压反馈 */
.pill-hover {
  opacity: 0.65;
}

/* ===== 日期选择弹层（月视图日历） ===== */
.date-picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 70;
}

.date-picker {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 71;
  background: var(--surface);
  border-radius: 24rpx 24rpx 0 0;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

/* 头部：上月 / 标题 / 下月 */
.cal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 8rpx 16rpx;
}

.cal-title {
  font-size: var(--title-2);
  font-weight: var(--title-w);
  color: var(--title-ink);
  font-family: var(--font-display);
  letter-spacing: var(--title-track);
}

.cal-nav {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: var(--ink);
  border-radius: 50%;
}

.cal-nav:active {
  background: var(--line-soft);
}

/* 周标题行 */
.cal-week-row {
  display: flex;
}

.cal-week {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: var(--ink-soft);
  padding: 12rpx 0;
}

/* 日期网格：7 列 */
.cal-grid {
  display: flex;
  flex-wrap: wrap;
}

.cal-cell {
  width: 14.285%;
  height: 96rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.cal-cell.blank {
  pointer-events: none;
}

.cal-cell.future {
  opacity: 0.3;
  pointer-events: none;
}

.cal-cell.selected .cal-day {
  background: var(--brand);
  color: var(--surface);
  font-weight: 600;
}

.cal-day {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--ink);
  box-sizing: border-box;
}

.cal-day.today {
  border: 2rpx solid var(--brand);
  color: var(--brand);
  font-weight: 600;
}

/* 绿点：该日期已保存日记 */
.cal-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  margin-top: 6rpx;
  background: transparent;
}

.cal-dot.on {
  background: var(--brand);
}

.cal-cell.selected .cal-dot.on {
  background: var(--surface);
}

/* 底部提示 */
.cal-foot {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 20rpx 0 8rpx;
  font-size: 22rpx;
  color: var(--ink-soft);
}

/* 心情胶囊（可选择：彩色底 + 下拉箭头） */
.mood-pill {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 22rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  font-weight: 500;
}

/* 天气：纯展示，不可交互（无背景、无箭头） */
.weather-chip {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: var(--ink-soft);
  max-width: 46%;
}

.weather-icon {
  font-size: 28rpx;
  margin-right: 6rpx;
  flex-shrink: 0;
}

.weather-city {
  font-size: 24rpx;
  color: var(--ink-soft);
  margin-right: 8rpx;
  max-width: 160rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.weather-temp {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--ink-faint);
}

/* 心情选择浮层 */
.mood-picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: transparent;
  z-index: 60;
}

.mood-picker {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  z-index: 61;
  background: var(--surface);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.12);
  padding: 24rpx;
}

.mood-picker-title {
  font-size: var(--title-3);
  color: var(--title-ink-3);
  font-family: var(--font-display);
  font-weight: var(--title-w-3);
  letter-spacing: var(--title-track-3);
  margin-bottom: 20rpx;
}

.mood-picker-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.mood-picker-option {
  padding: 12rpx 26rpx;
  background: var(--bg-soft);
  border-radius: 40rpx;
  font-size: 26rpx;
  color: var(--ink-mid);
}

.mood-picker-option.active {
  background: linear-gradient(135deg, var(--brand-bright) 0%, var(--brand-deep) 100%);
  color: var(--surface);
  font-weight: 500;
}

/* 日记正文卡片 */
.diary-card {
  background: var(--surface);
  border-radius: 20rpx;
  padding: 28rpx 28rpx 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  /* 高度封顶：内容短＝自然高度；内容超出可用空间＝收缩到上限，由内部滚动区承接。
     min-height: 0 才能突破 flex 默认最小内容高度，overflow: hidden 负责裁剪 */
  display: flex;
  flex-direction: column;
  flex: 0 1 auto;
  min-height: 0;
  overflow: hidden;
}

/* 卡片内部滚动区：文字 + 位置 + 图片/视频都在这里面滚 */
.card-scroll {
  flex: 1 1 auto;
  min-height: 0;
}

.card-scroll-inner {
  display: flex;
  flex-direction: column;
}

/* 卡片内的位置条：与外层卡片同底色，改浅底 + 去阴影，避免「卡中卡」 */
.diary-card .loc-card {
  background: var(--surface-soft);
  border: 1rpx solid var(--line-soft);
  border-radius: 16rpx;
  box-shadow: none;
}

/* 正文编辑区容器：承载自定义占位层 */
.diary-editor {
  position: relative;
}

/* 自定义占位层：覆盖在 textarea 上方，不拦截点击 */
.diary-placeholder {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  pointer-events: none;
  font-family: var(--content-font);
  font-size: var(--content-size);
  line-height: 1.9;
  color: var(--ink-faint);
}

.diary-placeholder .dp-line {
  white-space: pre-wrap;
}

.diary-textarea {
  width: 100%;
  box-sizing: border-box;
  background: transparent;
  font-family: var(--content-font);
  font-size: var(--content-size);
  color: var(--ink);
  line-height: 1.9;
  min-height: 400rpx;
  max-height: 60vh;
}

.char-count {
  text-align: right;
  font-size: 22rpx;
  color: var(--ink-faint);
  margin-top: 8rpx;
  padding-right: 8rpx;
}

/* ===== 修改指令结果高亮（替换/插入的词黄底标出）===== */
.hl-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.hl-badge {
  font-size: 24rpx;
  color: var(--brand-deep);
  background: var(--brand-tint-12);
  border-radius: 10rpx;
  padding: 8rpx 18rpx;
  max-width: 580rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.hl-close {
  font-size: 30rpx;
  color: var(--ink-faint);
  padding: 6rpx 12rpx;
}

.hl-content {
  display: block;
  width: 100%;
  box-sizing: border-box;
  font-family: var(--content-font);
  font-size: var(--content-size);
  color: var(--ink);
  line-height: 1.9;
  min-height: 220rpx;
  max-height: 60vh;
  overflow-y: auto;
  word-break: break-all;
}

.hl-content .hl-mark {
  background: var(--brand-bright);
  color: var(--brand-deep);
  font-weight: 600;
  border-radius: 6rpx;
  padding: 0 4rpx;
}

.hl-footer {
  text-align: right;
  font-size: 22rpx;
  color: var(--ink-faint);
  margin-top: 8rpx;
  padding-right: 8rpx;
}

/* ===== 位置卡片（微信位置消息样式）===== */
.loc-card {
  display: flex;
  align-items: center;
  background: var(--surface);
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-top: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

/* 地图选点同款大头针（红色圆头+白孔+尖角）；腿长 15→30rpx 延长一倍，容器加高并整体下移居中 */
.loc-icon {
  position: relative;
  width: 40rpx;
  height: 40rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 红色圆头（略带球面高光与投影） */
.loc-icon .pin-ball {
  position: absolute;
  top: 4rpx;
  left: 5rpx;
  width: 26rpx;
  height: 26rpx;
  border-radius: 50%;
  background: linear-gradient(180deg, var(--danger-bright) 0%, var(--danger) 55%, var(--danger-deep) 100%);
  box-shadow: inset 0 2rpx 2rpx rgba(255, 255, 255, 0.35), inset 0 -3rpx 4rpx var(--danger-shadow), 0 2rpx 4rpx rgba(0, 0, 0, 0.15);
}

/* 圆头正中白孔 */
.loc-icon .pin-hole {
  position: absolute;
  top: 12rpx;
  left: 50%;
  width: 8rpx;
  height: 8rpx;
  transform: translateX(-50%);
  background: var(--surface);
  border-radius: 50%;
  box-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.2);
}

/* 底部尖角（与圆头同色，圆头下沿被尖覆盖形成一体） */
.loc-icon .pin-tip {
  position: absolute;
  top: 23rpx;
  left: 50%;
  width: 0;
  height: 0;
  transform: translateX(-50%);
  border-left: 6rpx solid transparent;
  border-right: 6rpx solid transparent;
  border-top: 30rpx solid var(--danger-deep);
}

.loc-info {
  flex: 1;
  min-width: 0;
}

.loc-name {
  display: block;
  font-size: 28rpx;
  color: var(--ink);
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.loc-addr {
  display: block;
  font-size: 22rpx;
  color: var(--ink-soft);
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.loc-clear {
  font-size: 28rpx;
  color: var(--ink-faint);
  padding: 8rpx 0 8rpx 24rpx;
  flex-shrink: 0;
}

/* ===== 图片/视频缩略图 ===== */
.media-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 20rpx;
}

.media-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  overflow: visible;
}

.media-img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  background: var(--line-soft);
  display: block;
}

.media-video-badge {
  position: absolute;
  left: 0;
  bottom: 0;
  right: 0;
  background: rgba(0, 0, 0, 0.45);
  color: var(--surface);
  font-size: 20rpx;
  padding: 4rpx 8rpx;
  border-radius: 0 0 16rpx 16rpx;
}

.media-remove {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  color: var(--surface);
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ===== 工具行 ===== */
.tool-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 24rpx;
  /* 永不被压缩：卡片收缩腾出的高度全部由内部滚动区承担，按钮行始终完整可见 */
  flex-shrink: 0;
}

.tool-btn {
  flex-shrink: 0;
  background: var(--surface);
  border-radius: 44rpx;
  padding: 18rpx 40rpx;
  font-size: 28rpx;
  color: var(--ink-mid);
}

.tool-btn:active {
  background: var(--bg-soft);
}

.optimize-btn {
  background: linear-gradient(135deg, var(--ai) 0%, var(--ai-deep) 60%);
  color: var(--surface);
  border: none;
  font-weight: 500;
  box-shadow: 0 8rpx 20rpx var(--ai-shadow-25);
}

.optimize-btn:active {
  background: var(--ai-deep);
}

.optimize-btn.disabled {
  background: var(--ai-soft);
  color: var(--ai-deep);
  box-shadow: none;
  font-weight: normal;
}

.save-btn {
  flex: 1;
  background: linear-gradient(135deg, var(--brand-bright) 0%, var(--brand) 55%, var(--brand-deep) 100%);
  color: var(--surface);
  border: none;
  border-radius: 44rpx;
  padding: 18rpx 0;
  font-size: 30rpx;
  font-weight: 500;
  text-align: center;
  line-height: 1.5;
  box-shadow: 0 10rpx 24rpx var(--brand-shadow-28);
}

.save-btn:active {
  background: linear-gradient(135deg, var(--brand) 0%, var(--brand-deep) 100%);
}

.save-btn[disabled] {
  background: var(--brand-soft);
  color: var(--surface);
  box-shadow: none;
}

/* ===== 技术支持说明（左下角背景层）=====
   固定定位在固定输入栏上方；z-index 低于正文卡片/工具行，可被其压盖；
   pointer-events: none 保证不拦截滚动与点击（纯装饰）。
   底部偏移在 wxml 行内计算（输入栏高度 + safeAreaBottom） */
.tech-credit {
  position: fixed;
  left: 24rpx;
  /* 必须低于 .content-scroll 的 z-index:1，保证正文卡片/工具行能压盖说明文字；
     0 仍高于 .page 背景，故文字正常可见 */
  z-index: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
  pointer-events: none;
}

.tech-credit-icon {
  width: 26rpx;
  height: 26rpx;
  flex-shrink: 0;
  opacity: 0.5;
}

.tech-credit-text {
  font-size: 20rpx;
  line-height: 1.2;
  color: var(--ink-faint);
  letter-spacing: 0.5rpx;
  white-space: nowrap;
}

/* ===== 底部固定区：面板 + 输入栏 =====
   面板展开时压盖在编辑区、AI 优化/保存按钮之上 */
.write-bottom {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
  background: transparent;
}

/* ===== 底部输入栏（微信同款）===== */
.input-bar-wrap {
  flex-shrink: 0;
  z-index: 20;
}

.input-bar {
  flex-shrink: 0;
  display: flex;
  align-items: flex-end;
  background: var(--surface);
  border-top: 1rpx solid var(--line);
  padding: 12rpx 16rpx 22rpx;
  z-index: 20;
}

.input-btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  flex-shrink: 0;
}

.input-btn.active {
  background: var(--line-soft);
  border-radius: 16rpx;
}

.input-middle {
  flex: 1;
  min-width: 0;
  margin: 0 12rpx;
}

/* 按住说话（豆包同款圆角/底色） */
.hold-talk {
  height: 80rpx;
  background: var(--bg-soft);
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--ink);
}

.hold-talk:active,
.hold-talk.recording {
  background: var(--line-strong);
  color: var(--brand);
}

.hold-talk.canceling {
  background: var(--danger-soft);
  color: var(--danger-bright);
}

/* 快捷输入框（豆包同款圆角/底色） */
.input-text {
  width: 100%;
  box-sizing: border-box;
  background: var(--bg-soft);
  border-radius: 40rpx;
  padding: 16rpx 24rpx;
  font-size: 28rpx;
  color: var(--ink);
  line-height: 48rpx;
  min-height: 80rpx;
  max-height: 160rpx;
}

.input-add {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: 300;
  color: var(--ink);
  flex-shrink: 0;
}

.input-add.active {
  background: var(--line-soft);
  border-radius: 16rpx;
}

/* 发送态 */
.input-add.send {
  width: 120rpx;
  background: var(--brand);
  color: var(--surface);
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.input-add.send:active {
  background: var(--brand);
}


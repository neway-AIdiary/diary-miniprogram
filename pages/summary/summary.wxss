/* 智能总结页 —— 复用全局 design tokens，极简琥珀编辑风 */

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--bg);
  overflow: hidden;
}

/* ===== 中部滚动区 ===== */
.content-scroll {
  flex: 1;
  min-height: 0;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.content-inner {
  padding: var(--sp-md) 0 var(--sp-lg);
}

/* ===== 输入区 ===== */
.input-card {
  background: var(--surface);
  border: 1rpx solid var(--line-soft);
  border-radius: var(--r-lg);
  padding: var(--sp-md);
  box-shadow: var(--shadow-sm);
  margin-top: var(--sp-md);
  margin-bottom: var(--sp-md);
  position: relative;
}

.input-placeholder {
  position: absolute;
  top: 44rpx;
  left: 44rpx;
  right: 44rpx;
  pointer-events: none;
  font-family: var(--content-font);
  font-size: var(--content-size);
  color: var(--ink-faint);
  line-height: 1.7;
}

.placeholder-sub {
  font-size: 24rpx;
  color: var(--ink-faint);
  margin-top: 8rpx;
}

.prompt-textarea {
  width: 100%;
  min-height: 180rpx;
  font-family: var(--content-font);
  font-size: var(--content-size);
  line-height: 1.7;
  color: var(--ink);
}

/* ===== 底部固定底栏（与写日记主页 / 详情编辑页 / 档案页一致）===== */
.input-bar-wrap {
  flex-shrink: 0;
  z-index: 20;
}

.input-bar {
  flex-shrink: 0;
  display: flex;
  align-items: flex-end;
  background: var(--surface-frost);
  border-top: 1rpx solid var(--line-soft);
  padding: 12rpx 16rpx 22rpx;
  z-index: 20;
}

/* 中间区：flex:1 撑满左侧剩余空间（与写日记主页 / 详情编辑页 / 档案页完全一致） */
.input-middle {
  flex: 1;
  min-width: 0;
  margin: 0 12rpx;
}

/* 按住说话：尺寸/圆角/底色与写日记主页底栏完全一致 */
.hold-talk {
  height: 80rpx;
  background: var(--bg-soft);
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--ink);
}

.hold-talk:active,
.hold-talk.recording {
  background: var(--line-strong);
  color: var(--brand);
}

.hold-talk.connecting {
  color: var(--ink-soft);
}

.generate-btn {
  width: 160rpx;
  height: 80rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, var(--ai) 0%, var(--ai-deep) 60%);
  color: var(--ink-invert);
  border: none;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1;
  padding: 0;
  flex-shrink: 0;
  box-shadow: var(--shadow-brand);
  margin: 0;
}

.generate-btn::after { border: none; }

.generate-btn.disabled {
  background: var(--ai-soft);
  color: var(--ai-deep);
  box-shadow: none;
  opacity: 0.75;
}

/* ===== 快捷模板（竖向分行列表）===== */
.shortcuts {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: var(--sp-md);
}

.shortcut {
  display: flex;
  align-items: center;
  padding: 22rpx 24rpx;
  background: var(--surface);
  border: 1rpx solid var(--line-soft);
  border-radius: var(--r-md);
  font-size: 26rpx;
  color: var(--ink-mid);
}

/* 快捷指令图标：统一 yl-icon 字体图标，颜色随文字层级 */
.shortcut .ri {
  font-size: 32rpx;
  margin-right: 14rpx;
  color: var(--ink-soft);
}

.shortcut .shortcut-text {
  flex: 1;
  min-width: 0;
}

.shortcut:active {
  background: var(--brand-tint-08);
  border-color: var(--brand-tint-25);
}

/* ===== 结果区 ===== */
.result-area {
  margin-top: var(--sp-sm);
}

.result-placeholder {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.placeholder-icon {
  /* AI 识别符：羽毛笔（ri-quill-pen-line 字体图标）· 蓝色 --ai · 48rpx，
     与提示语同行排列，兼作空态占位标识。
     注意：字体图标不要设 width/height，否则字形会被裁切 */
  font-size: 48rpx;
  color: var(--ai);
  margin-right: 12rpx;
}

.placeholder-text {
  font-size: 26rpx;
  color: var(--ink-soft);
}

.result-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.loading-text {
  font-size: 26rpx;
  color: var(--ink-soft);
  margin-top: var(--sp-md);
}

.result-error {
  padding: 40rpx;
  text-align: center;
  color: var(--danger);
  font-size: 26rpx;
}

.result-card {
  background: var(--surface);
  border: 1rpx solid var(--line-soft);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-sm);
  overflow: hidden;
}

.result-header {
  padding: var(--sp-md) var(--sp-md) var(--sp-sm);
  border-bottom: 1rpx solid var(--line-soft);
}

.result-title {
  font-family: var(--font-display);
  font-size: 22rpx;
  color: var(--brand);
  letter-spacing: 1rpx;
  margin-bottom: 8rpx;
}

.result-prompt {
  font-size: 28rpx;
  color: var(--ink);
  line-height: 1.6;
}

.result-meta {
  padding: 0 var(--sp-md) var(--sp-sm);
  font-size: 22rpx;
  color: var(--ink-soft);
}

.result-scroll {
  max-height: 600rpx;
  padding: var(--sp-sm) var(--sp-md) var(--sp-md);
  box-sizing: border-box;
}

.result-content {
  font-family: var(--content-font);
  font-size: var(--content-size);
  line-height: 1.8;
  color: var(--ink);
  word-break: break-all;
}

/* 结果操作按钮 */
.result-actions {
  display: flex;
  gap: var(--sp-sm);
  margin-top: var(--sp-md);
}

.action-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 24rpx 8rpx;
  background: var(--surface);
  border: 1rpx solid var(--line-soft);
  border-radius: var(--r-md);
}

.action-btn:active {
  background: var(--brand-tint-08);
}

.action-icon {
  font-size: 40rpx;
}

.action-text {
  font-size: 24rpx;
  color: var(--ink-mid);
}

/* ===== 语音录音浮层 ===== */
.voice-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.voice-modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(42, 38, 34, 0.4);
}

.voice-modal-body {
  position: relative;
  width: 520rpx;
  background: var(--surface);
  border-radius: var(--r-lg);
  padding: 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: var(--shadow-md);
}

.voice-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: var(--brand);
  margin-bottom: var(--sp-md);
}

.voice-dot.pulse {
  animation: voicePulse 1.2s ease-in-out infinite;
}

@keyframes voicePulse {
  0%, 100% { opacity: 0.4; transform: scale(1); }
  50% { opacity: 1; transform: scale(1.3); }
}

.voice-title {
  font-size: 28rpx;
  color: var(--ink);
  margin-bottom: var(--sp-md);
}

.voice-text-scroll {
  max-height: 200rpx;
  width: 100%;
}

.voice-text {
  font-family: var(--content-font);
  font-size: var(--content-size);
  color: var(--ink-mid);
  line-height: 1.7;
  word-break: break-all;
}

/* 加载动画点 */
.gen-dots {
  display: flex;
  gap: 12rpx;
}

.gen-dots .dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--ai);
  animation: dotPulse 1.2s ease-in-out infinite;
}

.gen-dots .dot2 { animation-delay: 0.2s; }
.gen-dots .dot3 { animation-delay: 0.4s; }

@keyframes dotPulse {
  0%, 100% { opacity: 0.3; transform: translateY(0); }
  50% { opacity: 1; transform: translateY(-6rpx); }
}

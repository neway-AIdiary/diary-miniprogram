<!-- 智能总结页 -->
<view class="page {{themeClass}}" style="{{fontStyle}}">

  <!-- 中部滚动区：时间范围 + 需求输入 + 快捷模板 + 结果 -->
  <scroll-view class="content-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="content-inner">

      <!-- 筛选区：时间范围胶囊（公共组件 range-picker）[range-toolbar v1] -->
      <range-picker id="rangePicker" bind:change="onRangeChange" />

      <!-- 需求输入区 -->
      <view class="input-card">
        <view class="input-placeholder" wx:if="{{!prompt}}">
          <view>输入或说出你的总结需求</view>
          <view class="placeholder-sub">例：汇总本月情绪变化、统计所有通勤相关日记</view>
        </view>
        <textarea
          class="prompt-textarea"
          value="{{prompt}}"
          bindinput="onPromptInput"
          maxlength="-1"
          auto-height
          show-confirm-bar="{{false}}"
          cursor-spacing="20"
        />
      </view>

      <!-- 快捷模板标签栏（竖向分行列表） -->
      <view class="shortcuts">
        <view
          class="shortcut"
          wx:for="{{shortcuts}}"
          wx:key="label"
          bindtap="onShortcut"
          data-fill="{{item.fill}}"
        >
          <text class="ri {{item.icon}}"></text>
          <text class="shortcut-text">{{item.label}}</text>
        </view>
      </view>

      <!-- AI 结果展示区 -->
      <view class="result-area">
        <!-- 初始状态 -->
        <view class="result-placeholder" wx:if="{{!loading && !error && !hasResult}}">
          <text class="ri ri-quill-pen-line placeholder-icon"></text>
          <view class="placeholder-text">AI将根据您的指示生成总结</view>
        </view>

        <!-- Loading -->
        <view class="result-loading" wx:if="{{loading}}">
          <view class="gen-dots">
            <view class="dot dot1"></view>
            <view class="dot dot2"></view>
            <view class="dot dot3"></view>
          </view>
          <view class="loading-text">正在读取日记，AI 正在分析，请稍候…</view>
        </view>

        <!-- 错误 -->
        <view class="result-error" wx:if="{{error && !loading}}">
          <text>{{error}}</text>
        </view>

        <!-- 成功结果不再在本页展示：生成成功后直接跳「总结结果」页（pages/summary-result） -->
      </view>

    </view>
  </scroll-view>

  <!-- 底部固定底栏（与写日记主页 / 详情编辑页 / 档案页结构一致） -->
  <view class="input-bar-wrap">
    <view class="input-bar" style="padding-bottom: calc(22rpx + {{safeAreaBottom}}px);">
      <!-- 中间区：按住说话（默认语音输入） -->
      <view class="input-middle">
        <view
          class="hold-talk {{recording ? 'recording' : ''}} {{connecting ? 'connecting' : ''}}"
          bindtouchstart="onHoldStart"
          bindtouchend="onHoldEnd"
          bindtouchcancel="onHoldEnd"
        >{{recording ? '松开 结束' : (connecting ? '连接中…' : '按住 说话')}}</view>
      </view>

      <!-- 右侧：生成总结 -->
      <button class="generate-btn {{prompt ? '' : 'disabled'}}" disabled="{{!prompt || loading}}" bindtap="onGenerate">{{loading ? '分析中' : '生成总结'}}</button>
    </view>
  </view>

  <!-- 语音录音浮层（简化） -->
  <view class="voice-modal" wx:if="{{recording || transcribing}}">
    <view class="voice-modal-mask"></view>
    <view class="voice-modal-body">
      <view class="voice-dot {{recording ? 'pulse' : ''}}"></view>
      <view class="voice-title">{{transcribing ? '语音识别中' : '正在聆听'}}</view>
      <scroll-view class="voice-text-scroll" scroll-y enhanced show-scrollbar="{{false}}">
        <text class="voice-text">{{liveText || (recording ? '请说话…' : '识别中…')}}</text>
      </scroll-view>
    </view>
  </view>

</view>

<!-- 智能总结页 -->
<view class="page {{themeClass}}" style="{{fontStyle}}">

  <!-- 中部滚动区：时间范围 + 需求输入 + 快捷模板 + 结果 -->
  <scroll-view class="content-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="content-inner" style="{{scrollMinHeight ? 'min-height:' + scrollMinHeight + 'px' : ''}}">

      <!-- 筛选区：时间范围胶囊（公共组件 range-picker）[range-toolbar v1] -->
      <range-picker id="rangePicker" bind:change="onRangeChange" />

      <!-- 需求输入区（[summary-freeze v1] 生成中 disabled：textarea 是原生组件，
           同层渲染下未必被遮罩压住，这里必须是第二道闸） -->
      <view class="input-card">
        <view class="input-placeholder" wx:if="{{!prompt}}">
          <view>输入或说出你的总结需求</view>
          <view class="placeholder-sub">例：汇总本月情绪变化、统计所有通勤相关日记</view>
        </view>
        <textarea
          class="prompt-textarea"
          value="{{prompt}}"
          disabled="{{loading}}"
          bindinput="onPromptInput"
          maxlength="-1"
          auto-height
          show-confirm-bar="{{false}}"
          cursor-spacing="20"
        />
      </view>

      <!-- 快捷模板说明行 [summary-shortcut v1.3]
           左：区块标题；右：一句话讲清两种点击（chip = 立即生成 / 整句 = 只填入）
           用词有避讳（见记忆 MEMORY-modules 该条），改文案前先看那一节 -->
      <view class="shortcuts-head">
        <view class="shortcuts-title">快捷模板</view>
        <view class="shortcuts-hint">点左侧直接生成 · 点右侧填入输入框</view>
      </view>

      <!-- 快捷模板（竖向分行列表）[summary-shortcut v1.3]
           chip = 前几字：catchtap 阻断冒泡 → 点击即按整句生成（不联动时间范围）
           行内其余区域：bindtap → 只把整句填入输入框 -->
      <view class="shortcuts">
        <view
          class="shortcut {{loading ? 'shortcut-busy' : ''}}"
          wx:for="{{shortcuts}}"
          wx:key="chip"
          bindtap="onShortcut"
          data-fill="{{item.label}}"
        >
          <view class="shortcut-chip" catchtap="onQuickGenerate" data-label="{{item.label}}" data-chip="{{item.chip}}">{{item.chip}}</view>
          <view class="shortcut-text">{{item.label}}</view>
        </view>
      </view>

      <!-- AI 结果展示区 -->
      <view class="result-area">
        <!-- 初始状态 -->
        <view class="result-placeholder" wx:if="{{!loading && !error && !hasResult}}">
          <text class="ri ri-quill-pen-line placeholder-icon"></text>
          <view class="placeholder-text">AI将根据你的指示生成总结</view>
        </view>

        <!-- Loading -->
        <view class="result-loading" wx:if="{{loading}}">
          <view class="gen-dots">
            <view class="dot dot1"></view>
            <view class="dot dot2"></view>
            <view class="dot dot3"></view>
          </view>
          <view class="loading-text">正在读取日记，AI 正在分析，请稍候…</view>
        </view>

        <!-- 错误 -->
        <view class="result-error" wx:if="{{error && !loading}}">
          <text>{{error}}</text>
        </view>

        <!-- 成功结果不再在本页展示：生成成功后直接跳「总结结果」页（pages/summary-result） -->
      </view>

    </view>
  </scroll-view>

  <!-- [summary-freeze v1] 生成中整页冻结遮罩：吞掉全部点击与滑动（catchtap + catchtouchmove）
       z-index 300 是数值夹逼出来的硬约束：
         · 必须 > 201（range-picker 弹层 200/201）—— 低了盖不住时间胶囊本体与其弹层
         · 必须 < 1000（.voice-modal 语音浮层）—— 高了会盖住浮层，导致「先按住说话 → 再点生成」
           时松手事件被吞、录音永远结束不了
       6% 极淡压暗表示「当前不可操作」：全透明会让用户误判卡死；不加文案/动画（结果区与底栏已有状态） -->
  <view
    class="gen-mask"
    wx:if="{{loading}}"
    catchtap="onFrozenTap"
    catchtouchmove="onFrozenTap"
  ></view>

  <!-- 底部固定底栏（与写日记主页 / 详情编辑页 / 档案页结构一致） -->
  <view class="input-bar-wrap">
    <view class="input-bar" style="padding-bottom: calc(22rpx + {{safeAreaBottom}}px);">
      <!-- 中间区：按住说话（默认语音输入） -->
      <view class="input-middle">
        <view
          class="hold-talk {{recording ? 'recording' : ''}} {{connectingSlow ? 'connecting' : ''}}"
          bindtouchstart="onHoldStart"
          bindtouchend="onHoldEnd"
          bindtouchcancel="onHoldEnd"
        >{{recording ? '松开 结束' : (connectingSlow ? '连接中…' : '按住 说话')}}</view>
      </view>

      <!-- 右侧：生成总结 -->
      <button class="generate-btn {{prompt ? '' : 'disabled'}}" disabled="{{!prompt || loading}}" bindtap="onGenerate">{{loading ? '分析中' : '生成总结'}}</button>
    </view>
  </view>

  <!-- 语音录音浮层（简化） -->
  <view class="voice-modal" wx:if="{{recording || transcribing || connecting}}">
    <view class="voice-modal-mask"></view>
    <view class="voice-modal-body">
      <view class="voice-dot {{recording ? 'pulse' : ''}}"></view>
      <view class="voice-title">{{transcribing ? '语音识别中' : (connectingSlow ? '准备中' : '正在聆听')}}</view>
      <scroll-view class="voice-text-scroll" scroll-y enhanced show-scrollbar="{{false}}" scroll-top="{{voiceScrollTop}}">
        <text class="voice-text">{{liveText || (connectingSlow ? '请稍候…' : (recording || connecting ? '请说话…' : '识别中…'))}}</text>
      </scroll-view>
    </view>
  </view>

</view>

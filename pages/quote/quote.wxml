<!-- 每日一签 · 全篇页：正文来自 utils/dailyQuote.js，本页只负责排版 -->
<view class="page {{themeClass}}">
  <!-- [quote-date v4] 日期头：日历图标 + 两行文字，整块左对齐；节气不带 emoji；
       第 1 行 = 日期 + 星期几（主视觉）；第 2 行 = 干支日期 + 生肖 + 星座 + 节气；
       图标列宽即悬挂缩进，两行文字同一起点；‹›翻日按钮贴日期头右缘（margin-left:auto） -->
  <view class="date-head">
    <view class="date-icon-col">
      <view class="date-icon">
        <view class="date-icon-band"></view>
        <view class="date-icon-pin date-icon-pin-l"></view>
        <view class="date-icon-pin date-icon-pin-r"></view>
        <view class="date-icon-dot"></view>
      </view>
    </view>
    <view class="date-text">
      <view class="date-line1">{{gregorian}}　{{weekday}}</view>
      <view class="date-line2"><text wx:if="{{lunarFull}}">{{lunarFull}} · </text><text wx:if="{{zodiac}}">{{zodiac}} · </text>{{constellation}}<text wx:if="{{termName}}"> · {{termName}}</text></view>
    </view>
    <view class="date-nav">
      <view class="quote-nav-btn {{canPrev ? '' : 'quote-nav-off'}}" hover-class="quote-nav-hover"
            bindtap="onPrevDay" aria-label="前一天">‹</view>
      <view class="quote-nav-btn {{canNext ? '' : 'quote-nav-off'}}" hover-class="quote-nav-hover"
            bindtap="onNextDay" aria-label="后一天">›</view>
    </view>
  </view>
  <view class="date-rule"></view>

  <view class="quote-wrap">
    <view class="quote-kind-row">
      <view class="quote-kind">{{kind}}</view>
    </view>
    <view class="quote-head">{{head}}</view>
    <view class="quote-byline" wx:if="{{byline}}">{{byline}}</view>

    <view class="quote-rule"></view>

    <view class="quote-body">{{body}}</view>

    <view class="quote-btn" bindtap="copyAll" hover-class="quote-btn-hover">复制全文</view>
    <view class="quote-foot">{{appName}} · 以一灯传诸灯，终至万灯皆明</view>
  </view>
</view>

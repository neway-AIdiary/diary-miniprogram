/* ===== 首页 · 日记列表
   美学：极简克制 · 琥珀暖色 · 编辑杂志风
   规则：颜色一律走 app.wxss 令牌；标题用衬线展示字；靠发丝线与留白分层
   —— 结构类名与 wxml 保持一致，仅改视觉 ===================== */
.page {
  min-height: 100vh;
  background: var(--bg);
}

/* ---------- 顶部统计栏：杂志数据条 ---------- */
.stats-bar {
  display: flex;
  align-items: stretch;
  justify-content: space-around;
  background: var(--surface);
  border: 1rpx solid var(--line-soft);
  border-radius: var(--r-lg);
  padding: 32rpx 24rpx 28rpx;
  margin: 24rpx 24rpx 0;
  box-shadow: var(--shadow-sm);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

/* 数字用衬线展示字 + 琥珀色，形成视觉锚点 */
.stat-num {
  font-family: var(--font-display);
  font-size: 52rpx;
  font-weight: 600;
  color: var(--brand);
  line-height: 1.05;
  letter-spacing: 1rpx;
}

.stat-label {
  font-size: 22rpx;
  color: var(--ink-soft);
  margin-top: 12rpx;
  letter-spacing: 1rpx;
}

.stat-divider {
  width: 1rpx;
  background: var(--line-soft);
  align-self: center;
  height: 56rpx;
}

/* ---------- 搜索栏：暖灰槽 ---------- */
.search-bar {
  padding: 24rpx 24rpx 8rpx;
}

.search-box {
  display: flex;
  align-items: center;
  background: var(--bg-soft);
  border: 1rpx solid transparent;
  border-radius: var(--r-md);
  padding: 18rpx 28rpx;
  transition: border-color var(--dur) var(--ease), background var(--dur) var(--ease);
}

.search-box:focus-within {
  background: var(--surface);
  border-color: var(--brand);
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--ink);
}

.search-clear {
  font-size: 28rpx;
  color: var(--ink-faint);
  padding: 0 8rpx;
}

.search-tip {
  font-size: 24rpx;
  color: var(--ink-soft);
  padding: 16rpx 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.search-tip-reset {
  color: var(--brand);
  letter-spacing: 0.5rpx;
}

.empty-sub {
  font-size: 26rpx;
  color: var(--brand);
  margin-top: 16rpx;
  padding-bottom: 4rpx;
}

/* ---------- 日记列表 ---------- */
.diary-list {
  padding: 16rpx 24rpx 48rpx;
}

.diary-item {
  margin-bottom: 20rpx;
}

/* 卡片：暖白 + 发丝边框 + 左侧琥珀细标（编辑感来源） */
.diary-card {
  position: relative;
  background: var(--surface);
  border: 1rpx solid var(--line-soft);
  border-radius: var(--r-lg);
  padding: 32rpx 32rpx 28rpx 36rpx;
  box-shadow: var(--shadow-sm);
  transition: background var(--dur) var(--ease), border-color var(--dur) var(--ease), transform var(--dur) var(--ease);
}

.diary-card::before {
  content: '';
  position: absolute;
  left: 0;
  top: 28rpx;
  bottom: 28rpx;
  width: 4rpx;
  border-radius: 0 4rpx 4rpx 0;
  background: var(--brand);
  opacity: 0;
  transition: opacity var(--dur) var(--ease);
}

.diary-card:active {
  background: var(--surface-press);
  border-color: var(--line);
  transform: scale(0.995);
}

.diary-card:active::before {
  opacity: 1;
}

.diary-card-header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 14rpx;
}

/* 标题：衬线展示字，杂志感核心 */
.diary-title {
  font-family: var(--font-display);
  font-size: 34rpx;
  font-weight: 600;
  color: var(--ink);
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  letter-spacing: 0.5rpx;
}

/* AI 优化标签：琥珀描边小签 */
.tag-ai {
  font-size: 20rpx;
  color: var(--brand);
  background: var(--brand-tint-12);
  padding: 6rpx 16rpx;
  border-radius: var(--r-sm);
  flex-shrink: 0;
  margin-left: 16rpx;
  letter-spacing: 0.5rpx;
}

.diary-content {
  font-size: 27rpx;
  color: var(--ink-mid);
  line-height: 1.75;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
}

/* ---------- 卡片媒体缩略图 ---------- */
.diary-media {
  display: flex;
  gap: 12rpx;
  margin-top: 20rpx;
}

.diary-media-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: var(--r-md);
  overflow: hidden;
  flex-shrink: 0;
}

.diary-media-img {
  width: 100%;
  height: 100%;
  display: block;
  background: var(--bg-soft);
}

.diary-media-video {
  background: var(--ink);
  display: flex;
  align-items: center;
  justify-content: center;
}

.diary-media-video-icon {
  font-size: 48rpx;
  color: var(--ink-invert);
}

/* 视频封面播放角标 */
.diary-media-video-tag {
  position: absolute;
  right: 8rpx;
  bottom: 8rpx;
  display: flex;
  align-items: center;
  padding: 2rpx 10rpx;
  border-radius: 16rpx;
  background: rgba(0, 0, 0, 0.55);
  color: var(--ink-invert);
  font-size: 20rpx;
  line-height: 1.5;
}

.diary-media-video-tag-dur {
  margin-left: 4rpx;
}

/* ---------- 卡片位置 & 天气 ---------- */
.diary-location {
  font-size: 24rpx;
  color: var(--ink-soft);
  margin-top: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.diary-location .diary-weather {
  margin-left: 24rpx;
}

.diary-card-footer {
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--line-soft);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.tag-mood {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: var(--r-sm);
}

.footer-left {
  display: flex;
  align-items: flex-start; /* 标签换行时，心情 pill 保持顶部一行，不被撑成两行 */
  flex: 1;
  min-width: 0;
}

.tag-list {
  display: flex;
  align-items: flex-start;
  flex-wrap: wrap;
  margin-left: 24rpx;
}

/* #标签：琥珀弱化色 */
.tag-item {
  font-size: 22rpx;
  color: var(--brand-mute);
  margin-right: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tag-mood {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: var(--r-sm);
  white-space: nowrap;
  flex-shrink: 0;
  align-self: flex-start;
  line-height: 1;
}

.diary-date {
  font-size: 24rpx;
  color: var(--ink-faint);
  flex-shrink: 0;
  letter-spacing: 0.5rpx;
}

/* 空状态按钮 */
.empty-btn {
  margin-top: var(--sp-xl);
  padding: 20rpx 72rpx;
  display: inline-block;
}

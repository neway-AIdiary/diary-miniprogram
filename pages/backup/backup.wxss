.page {
  min-height: 100vh;
  background: var(--bg);
  padding-top: 24rpx;
  box-sizing: border-box;
}

/* 状态卡 */
.status-card {
  margin: 0 24rpx;
  background: var(--surface);
  border-radius: 16rpx;
  padding: 36rpx 32rpx;
  display: flex;
  align-items: center;
}

.status-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--line-soft);
  position: relative;
  flex-shrink: 0;
  margin-right: 24rpx;
}

/* 关闭状态：云朵轮廓（灰） */
.status-icon::before {
  content: '';
  position: absolute;
  left: 14rpx;
  top: 24rpx;
  width: 40rpx;
  height: 20rpx;
  border: 4rpx solid var(--ink-faint);
  border-radius: 12rpx;
}

.status-icon::after {
  content: '';
  position: absolute;
  left: 22rpx;
  top: 14rpx;
  width: 20rpx;
  height: 20rpx;
  border: 4rpx solid var(--ink-faint);
  border-bottom: none;
  border-radius: 12rpx 12rpx 0 0;
}

/* 开启状态：绿色实心云 + 白色对勾 */
.status-icon.on {
  background: var(--brand);
}

.status-icon.on::before {
  border-color: var(--surface);
  left: 16rpx;
  top: 28rpx;
  width: 36rpx;
  height: 16rpx;
}

.status-icon.on::after {
  border: none;
  left: 24rpx;
  top: 26rpx;
  width: 20rpx;
  height: 12rpx;
  border-left: 4rpx solid var(--surface);
  border-bottom: 4rpx solid var(--surface);
  border-radius: 0;
  transform: rotate(-45deg);
}

.status-info {
  flex: 1;
}

.status-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ink);
}

.status-sub {
  font-size: 24rpx;
  color: var(--ink-soft);
  margin-top: 8rpx;
}

/* 菜单：微信标准 cell 分组列表 */
.menu-section {
  padding: 0 24rpx;
  margin-top: 32rpx;
}

.menu-card {
  background: var(--surface);
  border-radius: 16rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid var(--line);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background: var(--bg-soft);
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: var(--ink);
}

.menu-text.danger {
  color: var(--danger);
}

.menu-arrow {
  font-size: 36rpx;
  color: var(--ink-faint);
  line-height: 1;
}

/* 状态提示 */
.backup-hint {
  padding: 16rpx 32rpx 0;
  font-size: 22rpx;
  color: var(--ink-soft);
  line-height: 1.7;
  white-space: pre-line;
}

/* 自动同步失败提示（红字） */
.sync-error {
  padding: 12rpx 32rpx 0;
  font-size: 22rpx;
  color: var(--danger);
  line-height: 1.7;
}

/* 隐私说明 */
.privacy-section {
  margin: 40rpx 24rpx 0;
  padding: 0 8rpx;
}

.privacy-title {
  font-size: 28rpx;
  color: var(--ink-soft);
  padding-bottom: 16rpx;
}

.privacy-text {
  font-size: 24rpx;
  color: var(--ink-soft);
  line-height: 1.8;
  margin-bottom: 6rpx;
}

/* 备份密码弹框 */
.backup-modal {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1100;
  display: flex;
  align-items: center;
  justify-content: center;
}

.backup-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
}

.backup-card {
  position: relative;
  z-index: 1;
  width: 640rpx;
  background: var(--surface);
  border-radius: 24rpx;
  padding: 40rpx 36rpx 32rpx;
  box-sizing: border-box;
}

.backup-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ink);
  text-align: center;
  margin-bottom: 20rpx;
}

.backup-desc {
  font-size: 24rpx;
  color: var(--ink-soft);
  line-height: 1.7;
  margin-bottom: 24rpx;
}

.backup-input {
  width: 100%;
  box-sizing: border-box;
  height: 80rpx;
  background: var(--line-soft);
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: var(--ink);
  margin-bottom: 20rpx;
}

.backup-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}

.backup-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
}

.backup-btn.cancel {
  background: var(--line-soft);
  color: var(--ink-mid);
}

.backup-btn.cancel:active {
  opacity: 0.7;
}

.backup-btn.ok {
  background: var(--brand);
  color: var(--surface);
  font-weight: 500;
}

.backup-btn.ok:active {
  background: var(--brand);
}

/* 危险操作按钮（清空云端备份确认） */
.backup-btn.danger {
  background: var(--danger);
  color: var(--surface);
  font-weight: 500;
}

.backup-btn.danger:active {
  background: var(--danger);
}

/* ============================================================
   [编辑风增强层] 备份与同步
   ============================================================ */
.status-card,
.menu-card {
  background: var(--surface);
  border: 1rpx solid var(--line-soft);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-sm);
}

.status-title {
  font-family: var(--font-display);
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ink);
  letter-spacing: 0.5rpx;
}

.status-sub,
.backup-desc,
.backup-hint,
.privacy-text {
  color: var(--ink-soft);
  font-size: 24rpx;
  line-height: 1.7;
}

.status-icon {
  filter: none;
}

.menu-section,
.privacy-title {
  font-family: var(--font-display);
  font-size: 26rpx;
  color: var(--ink-soft);
  letter-spacing: 2rpx;
}

.menu-item {
  transition: background var(--dur) var(--ease);
}

.menu-item:active {
  background: var(--surface-press);
}

.menu-arrow {
  color: var(--ink-faint);
}

.sync-error {
  color: var(--danger);
}

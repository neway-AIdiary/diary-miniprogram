/* ============================================================
   yl-icon 字体图标（Remix Icon 线性风格子集 · 28 枚 · WOFF base64 约 3KB）
   用法：<text class="ri ri-xxx"></text>，颜色/字号继承父级，可覆盖
   AI 识别符：ri-quill-pen-line（羽毛笔）配 --ai 系蓝色令牌
   由 build_icon_font.py 生成，勿手改 base64
   ============================================================ */
@font-face {
  font-family: "yl-icon";
  src: url("data:font/woff;base64,") format("woff");
}

.ri {
  font-family: "yl-icon";
  font-style: normal;
  font-weight: normal;
  display: inline-block;
  line-height: 1;
}


<!-- 隐私协议弹窗：首次使用前征求同意；蒙层与弹窗样式对齐全站弹窗范式 -->
<view class="pp-mask" wx:if="{{visible}}" catchtouchmove="true" bindtap="onDisagree">
  <view class="pp-modal" catchtap="noop">
    <view class="pp-title">用户协议与隐私政策</view>
    <view class="pp-desc">欢迎使用。使用前请阅读并同意</view>
    <view class="pp-links">
      <text class="pp-link" data-tab="terms" bindtap="goTerms">《用户协议》</text>
      <text class="pp-link" bindtap="goAgreement">《隐私政策》</text>
    </view>
    <view class="pp-desc-soft">我们会按约定保护你的个人信息，<text class="pp-strong">只有你能看到你的日记</text>；</view>
    <view class="pp-desc-soft pp-desc-soft-line2">不同意也可继续使用基础记录功能。</view>
    <button
      class="pp-btn-agree"
      open-type="agreePrivacyAuthorization"
      bindagreeprivacyauthorization="onAgree"
    >同意并继续</button>
    <view class="pp-btn-disagree" bindtap="onDisagree">暂不同意</view>
  </view>
</view>

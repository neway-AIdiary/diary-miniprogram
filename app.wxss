/* ===== 全局样式：微信小程序生态标准 UI（WeUI 通用风格）=====
   布局：浅青绿页面底 + 白色圆角卡片 + 系统级 cell 列表
   配色：微信生态通用绿 #07C160（原生 button 默认色）+ AI 琥珀金点缀
   版权：仅借鉴 WeUI 开源设计规范（MIT），不含微信 Logo/品牌图标/官方素材 */
page {
  background-color: #F0F6F2;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  color: #1A1A1A;
  line-height: 1.6;
}

/* 通用容器 */
.container {
  padding: 32rpx;
  box-sizing: border-box;
  min-height: 100vh;
}

/* 卡片：白底 + 圆角，靠背景色差分层（微信标准卡片） */
.card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

/* 主按钮：微信绿渐变 · 全宽胶囊 · 轻投影 */
.btn-primary {
  background: linear-gradient(135deg, #0ACF6C 0%, #06B256 55%, #059E4C 100%);
  color: #FFFFFF;
  border: none;
  border-radius: 48rpx;
  padding: 22rpx 48rpx;
  font-size: 32rpx;
  font-weight: 500;
  text-align: center;
  line-height: 1.5;
  box-shadow: 0 10rpx 24rpx rgba(7, 193, 96, 0.28);
}

.btn-primary:active {
  background: linear-gradient(135deg, #06B256 0%, #059E4C 100%);
  box-shadow: 0 6rpx 14rpx rgba(7, 193, 96, 0.22);
}

.btn-primary[disabled] {
  background: #BFE4CF;
  color: #FFFFFF;
  box-shadow: none;
}

/* 次按钮：浅绿底绿字胶囊 */
.btn-secondary {
  background: #EAF6EF;
  color: #07A056;
  border: 1rpx solid rgba(7, 193, 96, 0.25);
  border-radius: 48rpx;
  padding: 21rpx 48rpx;
  font-size: 32rpx;
  font-weight: 500;
  text-align: center;
  line-height: 1.5;
}

.btn-secondary:active {
  background: #DFF2E7;
}

/* 输入框 */
.input-field {
  background: #FFFFFF;
  border: 1rpx solid #E3EDE7;
  border-radius: 12rpx;
  padding: 22rpx 24rpx;
  font-size: 30rpx;
  width: 100%;
  box-sizing: border-box;
}

.textarea-field {
  background: #FFFFFF;
  border: 1rpx solid #E3EDE7;
  border-radius: 16rpx;
  padding: 28rpx;
  font-size: 30rpx;
  width: 100%;
  min-height: 400rpx;
  box-sizing: border-box;
  line-height: 1.8;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 0;
}

.empty-state .empty-icon {
  font-size: 60rpx;
  margin-bottom: 24rpx;
  opacity: 0.35;
}

.empty-state .empty-text {
  font-size: 28rpx;
  color: #999999;
}

/* 加载状态 */
.loading {
  text-align: center;
  padding: 40rpx;
  color: #999999;
  font-size: 26rpx;
}
